extends RefCounted
## S1 content.ts, travel-stage content. Definition order and RNG calls are part of the port.
## No stranded definitions are shipped; content_events.json is generated by content_port.ts.
const C = preload("res://game/train/turn/turn_common.gd")
const St = preload("res://game/train/train_state.gd")
const Climate = preload("res://game/train/train_climate.gd")
const Wounds = preload("res://game/train/turn/turn_wounds.gd")
const Death = preload("res://game/train/turn/turn_death.gd")
const METRIC: Dictionary = {"warmth": 0, "ration": 1, "crowding": 2, "exposure": 3}
const RES: Dictionary = {"coal": "coal", "food": "food", "medicine": "med", "luxury": "lux"}
const BASE: Dictionary = {"community.warmth": 0, "community.ration": 1, "community.crowding": 2, "community.exposure": 3}
const RES_NAME: Dictionary = {"coal": "석탄", "food": "식량", "medicine": "의약품", "luxury": "사치품", "symbol": "상징물"}
const SPEAKER_ROLE: Dictionary = {"captain": "열차장", "deputy": "부관", "ration_officer": "배급장", "rep": "대표", "aide": "측근", "faction_leader": "세력 지도자"}
const AWAY_FOREVER: int = 1000000
static var _data: Dictionary = {}


static func data() -> Dictionary:
	if _data.is_empty():
		_data = JSON.parse_string(FileAccess.get_file_as_string("res://game/train/content_events.json"))
	return _data


static func definition(kind: String, id: String) -> Dictionary:
	for row: Dictionary in data()[kind]:
		if row["id"] == id: return row
	return {}


## The same ordered upsert used by S1's registerContent* (also permits isolated fixture definitions).
static func register_definitions(kind: String, list: Array) -> void:
	var into: Array = data()[kind]
	for raw: Variant in list:
		if not raw is Dictionary or not raw.get("id") is String: continue
		if kind == "events" and not raw.get("choices") is Array: continue
		if kind == "secrets" and not raw.get("text") is String: continue
		if kind == "deals" and (not raw.get("ask") is Array or not raw.get("gives") is Array or not raw.get("breach") is Array): continue
		var found: int = -1
		for i: int in into.size():
			if into[i]["id"] == raw["id"]:
				found = i
				break
		if found >= 0: into[found] = raw
		else: into.append(raw)


static func in_event_pack(id: String) -> bool:
	if id.begins_with("ev_b01_"): return true
	return id.length() >= 7 and id.begins_with("ev_h") and id[4] in "0123456789" and id[5] in "0123456789" and id[6] == "_"


static func _comm(t: Dictionary, value: String) -> bool:
	return (t["COMMS"] as Array).has(value)


static func _pick(g: Dictionary, list: Array) -> Variant:
	return list[int(floor(C.rnd(g) * list.size()))]


static func _num(value: float) -> String:
	return str(int(value)) if value == floorf(value) and absf(value) < 1e15 else str(value)


## content.ts fillText uses josa.ts's pair form, including digit finals and the rieul exception.
static func particle(word: String, pair: String) -> String:
	var parts: PackedStringArray = pair.split("/")
	var clean: String = word.strip_edges()
	var last: String = clean.right(1)
	var final: int = 0
	if not clean.is_empty():
		var code: int = clean.unicode_at(clean.length() - 1)
		if code >= 0xac00 and code <= 0xd7a3: final = (code - 0xac00) % 28
		elif last in ["1", "7", "8"]: final = 8
		elif last in ["0", "3", "6"]: final = 1
	if parts[0] == "으로": return "으로" if final > 0 and final != 8 else "로"
	return parts[0] if final > 0 else parts[1]


static func fill_text(value: String, vals: Dictionary) -> String:
	var regex: RegEx = RegEx.new()
	regex.compile("\\{([a-z0-9]+)\\}(\\[([^\\]/]+/[^\\]]+)\\])?")
	var out: String = ""
	var at: int = 0
	for hit: RegExMatch in regex.search_all(value):
		out += value.substr(at, hit.get_start() - at)
		var key: String = hit.get_string(1)
		if vals.has(key):
			var word: String = str(vals[key])
			out += word + (particle(word, hit.get_string(3)) if hit.get_string(3) != "" else "")
		else: out += hit.get_string()
		at = hit.get_end()
	return out + value.substr(at)


static func person_state(g: Dictionary, t: Dictionary, id: String) -> String:
	var person: Dictionary = C.profile(t, id, "id")
	if person.is_empty(): return "dead"
	if g.get("contentAway", {}).has(id): return "away"
	if (g["deaths"] as Array).has(person["name"]): return "dead"
	if St.is_gone(g, person["name"]): return "away"
	if (g.get("contentInjured", []) as Array).has(id): return "injured"
	return "alive"


static func _flags(g: Dictionary) -> Dictionary:
	if not g.has("contentFlags"): g["contentFlags"] = {}
	return g["contentFlags"]


static func holds(g: Dictionary, t: Dictionary, condition: Dictionary) -> bool:
	match str(condition["type"]):
		"segment": return g["seg"] >= condition["min"] and g["seg"] <= condition["max"]
		"community":
			var value: float = float(St.situation(g, t, condition["community"])[METRIC[condition["metric"]]])
			var need: float = float(condition["value"])
			match str(condition["operator"]):
				"lt": return value < need
				"lte": return value <= need
				"eq": return floorf(value + 0.5) == need
				"gte": return value >= need
				_: return value > need
		"flag":
			var flags: Dictionary = _flags(g)
			if not flags.has(condition["id"]): return false
			var got: Variant = flags[condition["id"]]
			var want: Variant = condition["value"]
			var numbers: bool = (got is int or got is float) and (want is int or want is float)
			return (numbers or typeof(got) == typeof(want)) and got == want
		"person": return person_state(g, t, condition["id"]) == condition["state"]
		"season": return Climate.holds(g, t, condition["needs"])
		"resource":
			var value: float = float(g[RES.get(condition["resource"], "symbols")])
			return value <= float(condition["value"]) if condition["operator"] == "lte" else value >= float(condition["value"])
	return false


static func _all_hold(g: Dictionary, t: Dictionary, list: Array) -> bool:
	for condition: Dictionary in list:
		if not holds(g, t, condition): return false
	return true


static func speaker_comm(t: Dictionary, ev: Dictionary) -> String:
	if _comm(t, ev["speaker"]): return ev["speaker"]
	var comm: String = str(ev.get("community", ""))
	return comm if _comm(t, comm) else ""


static func _people(g: Dictionary, t: Dictionary, comm: String, except: Array = []) -> Array:
	var out: Array = []
	for person: Dictionary in t["PROFILES"]:
		if person["community"] == comm and person["name"] != g["comms"][comm]["leader"]["name"] and not St.is_gone(g, person["name"]) and person_state(g, t, person["id"]) == "alive" and not except.has(person["name"]): out.append(person["name"])
	return out


static func _dom_people(g: Dictionary) -> Array:
	var dom: Variant = g.get("dom")
	return dom.get("people", []) if dom is Dictionary else []


static func _person_pool(g: Dictionary, t: Dictionary, ev: Dictionary, comm: String, bind: String, except: Array) -> Array:
	if bind == "": return _people(g, t, comm, except)
	if bind.begins_with("community:"):
		var other: String = bind.substr(10)
		return _people(g, t, other, except) if _comm(t, other) else []
	var out: Array = []
	if bind.begins_with("role:"):
		for person: Dictionary in _dom_people(g):
			if person["alive"] and not person.get("gone", false) and person["role"] == bind.substr(5) and not except.has(person["name"]): out.append(person["name"])
		return out
	var ids: Array = []
	if bind == "witness":
		for choice: Dictionary in ev["choices"]:
			for witness: Variant in choice["witnesses"]:
				var id: String = witness if witness is String else str(witness["person"])
				if not ids.has(id): ids.append(id)
	elif bind == "scapegoat": ids = g.get("scapegoatOk", [])
	for id: String in ids:
		var person: Dictionary = C.profile(t, id, "id")
		if not person.is_empty() and person_state(g, t, id) == "alive" and not except.has(person["name"]): out.append(person["name"])
	return out


static func _last_law(g: Dictionary, repealed: bool = false) -> String:
	var out: String = ""
	var last: float = -INF
	var values: Dictionary = g["repealedAt"] if repealed else g["passed"]
	for law: String in values:
		if repealed and St.law_active(g, law): continue
		if float(values[law]) > last:
			last = float(values[law])
			out = law
	return out


static func _cars(t: Dictionary, comm: String) -> Array:
	var out: Array = []
	for car: String in t["CAR_COMM"]:
		if t["CAR_COMM"][car] == comm and t["CAR_NAME"].has(car): out.append(car)
	return out


static func _number(g: Dictionary, t: Dictionary, bind: String) -> Variant:
	match bind:
		"food_shortfall":
			var total: float = 0
			for comm: String in t["COMMS"]: total += float(g["comms"][comm]["pop"]) * float(g["comms"][comm]["ration"])
			return maxf(0, floorf(total * float(t["P"]["foodPerPersonLever"]) - float(g["food"]) + 0.5))
		"coal_left": return floorf(float(g["coal"]) + 0.5)
		"food_left": return floorf(float(g["food"]) + 0.5)
		"dead_last_segment":
			var count: int = 0
			for row: Dictionary in g.get("deathLog", []):
				if int(row["seg"]) == int(g["seg"]) - 1: count += 1
			return count
		"injured": return g["injured"]
		"away":
			var count: int = 0
			for comm: String in t["COMMS"]: count += int(g["comms"][comm]["away"])
			return count
	if bind.begins_with("pop:") and _comm(t, bind.substr(4)): return g["comms"][bind.substr(4)]["pop"]
	return null


static func _fixed(g: Dictionary, t: Dictionary, key: String, bind: String, comm: String) -> Variant:
	match key:
		"captain": return g.get("captainName", "열차장")
		"community":
			if bind == "": return t["COMM_NAME"][comm]
			if _comm(t, bind): return t["COMM_NAME"][bind]
			if bind not in ["lowest_relation", "highest_tension"]: return null
			var best: String = t["COMMS"][0]
			for candidate: String in t["COMMS"]:
				var a: Dictionary = g["comms"][candidate]
				var b: Dictionary = g["comms"][best]
				if (bind == "lowest_relation" and a["rel"] < b["rel"]) or (bind == "highest_tension" and (a["fervor"] > b["fervor"] or (a["fervor"] == b["fervor"] and a["rel"] < b["rel"]))): best = candidate
			return t["COMM_NAME"][best]
		"law":
			var law: String = _last_law(g) if bind == "" else (_last_law(g, true) if bind == "last_repealed" else (bind.substr(4) if bind.begins_with("law:") else ""))
			return t["LAWS"][law]["title"] if t["LAWS"].has(law) else null
		"place":
			if (bind == "" and g["phase"] == "stop" or bind == "last_stop") and g.get("stop") is Dictionary:
				var id: String = g["stop"]["place"]
				for place: Dictionary in t["PLACES"]:
					if place["id"] == id: return place["name"]
				return id
			return null
		"car":
			var cars: Array = _cars(t, bind.substr(4)) if bind.begins_with("car:") else []
			return t["CAR_NAME"][cars[0]] if not cars.is_empty() else null
		"item": return RES_NAME.get(bind.substr(9)) if bind.begins_with("resource:") else null
		"n", "n2":
			var value: Variant = _number(g, t, bind)
			return _num(float(value)) if value != null else null
	return null


static func _effects_ready(ev: Dictionary) -> bool:
	for choice: Dictionary in ev["choices"]:
		for effect: Dictionary in choice["effects"]:
			if effect["type"] == "secret" and definition("secrets", effect["id"]).is_empty(): return false
			if effect["type"] == "deal" and definition("deals", effect["id"]).is_empty(): return false
	return true


static func _binds_in(g: Dictionary, t: Dictionary, ev: Dictionary, comm: String) -> bool:
	var params: Array = ev.get("params", [])
	var binds: Dictionary = ev.get("bind", {})
	var wants_person: bool = params.has("person") or params.has("person2")
	var first: Array = _person_pool(g, t, ev, comm, binds.get("person", ""), []) if wants_person else []
	if wants_person and first.is_empty(): return false
	if params.has("person2"):
		var possible: bool = false
		for person: String in first:
			if not _person_pool(g, t, ev, comm, binds.get("person2", ""), [person]).is_empty(): possible = true
		if not possible: return false
	if ev["speaker"] == "aide" and _people(g, t, comm).is_empty(): return false
	if not wants_person and speaker_comm(t, ev) == "" and ev.get("community") != "any":
		for choice: Dictionary in ev["choices"]:
			for effect: Dictionary in choice["effects"]:
				if effect["type"] == "secret": return false
	for key: String in params:
		if key not in ["person", "person2"] and _fixed(g, t, key, binds.get(key, ""), comm) == null: return false
	return true


static func can_bind(g: Dictionary, t: Dictionary, ev: Dictionary) -> bool:
	if ev["speaker"] == "faction_leader" or not _effects_ready(ev): return false
	if ev.get("community") == "any" and not _comm(t, ev["speaker"]):
		for comm: String in t["COMMS"]:
			if _binds_in(g, t, ev, comm): return true
		return false
	var comm: String = speaker_comm(t, ev)
	return _binds_in(g, t, ev, comm if comm != "" else "tail")


static func _domestic_aide(g: Dictionary, t: Dictionary, comm: String) -> String:
	var role: String = {"engine": "견습 화부", "front": "약사"}.get(comm, "")
	if role == "": return ""
	var specialists: Array = t["SPECIALISTS"]
	for i: int in specialists.size():
		if specialists[i]["role"] != role: continue
		for person: Dictionary in _dom_people(g):
			if person["id"] == "sp%d" % (i + 1) and person["comm"] == comm and person["alive"] and not person.get("gone", false) and not St.is_gone(g, person["name"]): return person["name"]
		break
	return ""


static func _bind_values(g: Dictionary, t: Dictionary, ev: Dictionary, comm: String) -> Dictionary:
	var params: Array = ev.get("params", [])
	var binds: Dictionary = ev.get("bind", {})
	var vals: Dictionary = {}
	if params.has("person") or params.has("person2"):
		var pool: Array = _person_pool(g, t, ev, comm, binds.get("person", ""), [])
		var candidates: Array = []
		for person: String in pool:
			if not params.has("person2") or not _person_pool(g, t, ev, comm, binds.get("person2", ""), [person]).is_empty(): candidates.append(person)
		vals["person"] = _pick(g, candidates)
	if params.has("person2"): vals["person2"] = _pick(g, _person_pool(g, t, ev, comm, binds.get("person2", ""), [vals["person"]]))
	for key: String in params:
		if key not in ["person", "person2"]:
			var value: Variant = _fixed(g, t, key, binds.get(key, ""), comm)
			vals[key] = value if value != null else ""
	if params.has("car") and str(binds.get("car", "")).begins_with("car:"): vals["car"] = t["CAR_NAME"][_pick(g, _cars(t, str(binds["car"]).substr(4)))]
	if ev["speaker"] == "aide":
		var aide: String = _domestic_aide(g, t, comm)
		vals["@aide"] = aide if aide != "" else _pick(g, _people(g, t, comm))
	return vals


static func content_pool(g: Dictionary, t: Dictionary, phase: String = "travel") -> Array:
	var out: Array = []
	for ev: Dictionary in data()["events"]:
		if ev["phase"] != phase or not (ev["stage"] == "s1a" or (ev["stage"] == "s1c" and g.get("dom") is Dictionary)): continue
		if not g.get("eventPack", false) and in_event_pack(ev["id"]): continue
		var memo: Dictionary = g.get("eventLog", {}).get("content:" + str(ev["id"]), {})
		if not memo.is_empty() and (int(memo["n"]) > int(ev["repeat"]) or int(memo["n"]) >= int(t["EVENT_CHAIN_MAX"]) or int(g["seg"]) - int(memo["seg"]) < int(t["EVENT_COOLDOWN"])): continue
		# S1: a queued follow-up, or the same event already on a paper, is not drawn again.
		if _queued_or_held(g, str(ev["id"])): continue
		if _all_hold(g, t, ev["trigger"]) and can_bind(g, t, ev): out.append(ev)
	return out


static func _queued_or_held(g: Dictionary, id: String) -> bool:
	for queued: Dictionary in g.get("contentQueue", []):
		if queued["id"] == id: return true
	for pile: String in ["cards", "lateCards", "deferred"]:
		for card: Dictionary in g.get(pile, []) if g.get(pile) is Array else []:
			if card.get("kind") == "content" and card.get("text") == id: return true
	return false


static func content_draw_info(g: Dictionary, t: Dictionary, id: String) -> Dictionary:
	var ev: Dictionary = definition("events", id)
	if ev.is_empty(): return {"pressure": 1.0}
	var distance: float = 0
	for condition: Dictionary in ev["trigger"]:
		if condition["type"] != "community" or condition["operator"] == "eq": continue
		var value: float = float(St.situation(g, t, condition["community"])[METRIC[condition["metric"]]])
		distance = maxf(distance, float(condition["value"]) - value if condition["operator"] in ["lt", "lte"] else value - float(condition["value"]))
	var out: Dictionary = {"pressure": 1.0 + distance / float(data()["draw"]["pressDiv"])}
	var comm: String = speaker_comm(t, ev)
	if comm != "": out["comm"] = comm
	return out


static func add_content_card(g: Dictionary, t: Dictionary, id: String, front: bool = false, recheck: bool = false) -> bool:
	var ev: Dictionary = definition("events", id)
	if ev.is_empty() or not can_bind(g, t, ev): return false
	if recheck and not _all_hold(g, t, ev["trigger"]): return false
	var comm: String = speaker_comm(t, ev)
	if comm == "": comm = "tail"
	if ev.get("community") == "any" and not _comm(t, ev["speaker"]):
		var candidates: Array = []
		for other: String in t["COMMS"]:
			var probe: Dictionary = ev.duplicate()
			probe["community"] = other
			if can_bind(g, t, probe): candidates.append(other)
		comm = _pick(g, candidates)
	var card: Dictionary = {"kind": "content", "text": id, "comm": comm, "vals": _bind_values(g, t, ev, comm)}
	if front:
		card["uid"] = g["nextCardUid"]
		g["cards"].push_front(card)
		g["nextCardUid"] += 1
	else: C.card(g, card, t)
	return true


static func to_effs(t: Dictionary, list: Array) -> Array:
	var out: Array = []
	for effect: Dictionary in list:
		var kind: String = effect["type"]
		if RES.has(kind): out.append([RES[kind], effect["amount"]])
		elif BASE.has(kind) and _comm(t, effect.get("target", "")): out.append(["base", effect["target"], BASE[kind], effect["amount"]])
		elif kind in ["trust", "tension", "fear"]: out.append([kind, effect["amount"]])
		elif kind == "relation" and _comm(t, effect["target"]): out.append(["rel", effect["target"], effect["amount"]])
	return out


## Deferred deals use the same subset of applyEffs as content choices; no cards/text preload cycle.
static func _apply_effs(g: Dictionary, t: Dictionary, list: Array) -> void:
	for effect: Array in to_effs(t, list):
		match str(effect[0]):
			"coal", "food", "med", "lux", "trust", "tension": C.bump(g, effect[0], float(effect[1]), "card", effect[0] in ["med", "lux"])
			"fear": g["fear"] = clampf(float(g["fear"]) + float(effect[1]), 0, 100)
			"base": g["comms"][effect[1]]["base"][int(effect[2])] += float(effect[3])
			"rel": C.bump_rel(g, effect[1], float(effect[2]), "card")


static func _person_target(g: Dictionary, t: Dictionary, id: String) -> String:
	if id.begins_with("leader_") and _comm(t, id.substr(7)): return g["comms"][id.substr(7)]["leader"]["personId"]
	return id


static func _set_person(g: Dictionary, t: Dictionary, id: String, state: String) -> void:
	var person: Dictionary = C.profile(t, id, "id")
	if person.is_empty(): return
	if state == "dead" and not (g["deaths"] as Array).has(person["name"]): Death.on_death(g, t, person["community"], [person["name"]], "other")
	elif state == "injured":
		if not g.has("contentInjured"): g["contentInjured"] = []
		if not (g["contentInjured"] as Array).has(id):
			g["contentInjured"].append(id)
			g["injured"] += 1
			Wounds.note_injury(g, t, 1, "stop", "사건", {"names": [person["name"]], "comm": person["community"]})
	elif state == "away":
		if not g.has("contentAway"): g["contentAway"] = {}
		g["contentAway"][id] = AWAY_FOREVER
	elif state == "alive":
		g["contentInjured"] = (g.get("contentInjured", []) as Array).filter(func(value: String) -> bool: return value != id)
		if g.has("contentAway"): g["contentAway"].erase(id)


static func _queue(g: Dictionary, t: Dictionary, id: String, delay: int) -> void:
	if delay <= 0: add_content_card(g, t, id, true, true)
	else:
		if not g.has("contentQueue"): g["contentQueue"] = []
		g["contentQueue"].append({"id": id, "at": int(g["seg"]) + delay})


static func _gain_secret(g: Dictionary, t: Dictionary, id: String, amount: float, ctx: Dictionary) -> void:
	var def: Dictionary = definition("secrets", id)
	if def.is_empty(): return
	var level: int = 2 if amount >= 2 or def["proof"] == "evidence" else 1
	var who: String = ctx["vals"].get("person", g["comms"][ctx["comm"]]["leader"]["name"])
	var person: Dictionary = C.profile(t, who)
	var comm: String = person.get("community", ctx["comm"])
	if not g.has("contentSecrets"): g["contentSecrets"] = {}
	var had: Dictionary = g["contentSecrets"].get(id, {})
	if not had.is_empty() and int(had["level"]) >= level: return
	g["contentSecrets"][id] = {"level": level, "who": who, "comm": comm}
	var line: String = fill_text(def["text"], {"person": who})
	var old: Dictionary = {}
	for secret: Dictionary in g["secrets"]:
		if secret.get("cid") == id:
			old = secret
			break
	if not old.is_empty(): old["proof"] = level
	else:
		g["secrets"].append({"id": g["nextSecretId"], "text": line, "weight": clampf(floorf(float(def["severity"]) + 0.5), 1, 3), "about": comm, "uses": 0, "cid": id, "proof": level})
		g["nextSecretId"] += 1
	C.journal(g, ("증거를 쥐었다: " if level == 2 else "소문을 들었다: ") + line, "dark")


static func _add_deal_card(g: Dictionary, t: Dictionary, id: String, comm: String) -> void:
	var def: Dictionary = definition("deals", id)
	if def.is_empty(): return
	g["cards"].push_front({"uid": g["nextCardUid"], "kind": "content-deal", "text": id, "comm": def["from"] if _comm(t, def["from"]) else comm})
	g["nextCardUid"] += 1


static func apply_rest(g: Dictionary, t: Dictionary, list: Array, ctx: Dictionary) -> void:
	var flags: Dictionary = _flags(g)
	for effect: Dictionary in list:
		match str(effect["type"]):
			"symbol": g["symbols"] = maxf(0, float(g["symbols"]) + float(effect["amount"]))
			"cohesion":
				if _comm(t, effect["target"]): g["comms"][effect["target"]]["coh"] = clampf(float(g["comms"][effect["target"]]["coh"]) + float(effect["amount"]), 0, 1)
			"flag": flags[effect["id"]] = effect["value"]
			"followup": _queue(g, t, effect["id"], int(effect["delay"]))
			"person.state": _set_person(g, t, _person_target(g, t, effect["target"]), effect["state"])
			"person.away":
				if not g.has("contentAway"): g["contentAway"] = {}
				g["contentAway"][_person_target(g, t, effect["target"])] = int(g["seg"]) + int(effect["segments"])
			"secret": _gain_secret(g, t, effect["id"], float(effect["amount"]), ctx)
			"votes":
				if not _comm(t, effect["target"]): continue
				if not g.has("voteShift"): g["voteShift"] = []
				var side: String = effect.get("side", "captain")
				var shift: Dictionary = {}
				for row: Dictionary in g["voteShift"]:
					if row["comm"] == effect["target"] and row["side"] == side:
						shift = row
						break
				if not shift.is_empty(): shift["n"] += effect["amount"]
				else: g["voteShift"].append({"comm": effect["target"], "n": effect["amount"], "side": side})
			"deal": _add_deal_card(g, t, effect["id"], ctx["comm"])
			"chronicle":
				if not g.has("chronicle"): g["chronicle"] = []
				g["chronicle"].append({"template": effect["id"], "who": ctx["vals"].get("person", ctx["speaker"]), "where": g["stop"]["place"] if g["phase"] == "stop" and g.get("stop") is Dictionary else "", "when": g["seg"], "witnesses": ctx["witnesses"], "from": ctx["from"]})


static func content_away_tick(g: Dictionary) -> void:
	var away: Dictionary = g.get("contentAway", {})
	for id: String in away.keys():
		if int(away[id]) <= int(g["seg"]): away.erase(id)


static func _shortfall(g: Dictionary, effs: Array) -> String:
	for effect: Array in effs:
		if effect[0] in ["coal", "food", "med", "lux"] and float(effect[1]) < 0 and float(g[effect[0]]) < -float(effect[1]):
			return {"coal": "석탄이 모자라다", "food": "식량이 모자라다", "med": "의약품이 모자라다", "lux": "사치품이 모자라다"}[effect[0]]
	return ""


static func _can_pay(g: Dictionary, t: Dictionary, list: Array) -> bool:
	if _shortfall(g, to_effs(t, list)) != "": return false
	for effect: Dictionary in list:
		if effect["type"] == "symbol" and float(effect["amount"]) < 0 and float(g["symbols"]) < -float(effect["amount"]): return false
	return true


static func _sign(value: float) -> String:
	return ("+" if value > 0 else "−") + _num(absf(value))


static func effect_text(t: Dictionary, list: Array) -> String:
	var costs: Array[String] = []
	var politics: Array[String] = []
	var names: Dictionary = {"coal": "석탄", "food": "식량", "med": "의약품", "lux": "사치품"}
	for effect: Array in to_effs(t, list):
		match str(effect[0]):
			"coal", "food", "med", "lux": costs.append("%s %s" % [names[effect[0]], _sign(float(effect[1]))])
			"base": costs.append("%s %s %s" % [t["COMM_NAME"][effect[1]], ["온기", "배급", "과밀", "노출"][int(effect[2])], _sign(float(effect[3]))])
			"rel": politics.append("%s %s %s %s" % [t["COMM_NAME"][effect[1]], "지지" if float(effect[2]) > 0 else "불만", "크게" if absf(float(effect[2])) >= 8 else "약간", "↑"])
			"trust": politics.append("신임 %s" % _sign(float(effect[1])))
			"tension": politics.append("긴장 %s" % _sign(float(effect[1])))
			"fear": politics.append("공포가 돈다")
	costs.append_array(politics)
	for effect: Dictionary in list:
		if effect["type"] == "symbol": costs.append("상징물 %s" % _sign(float(effect["amount"])))
	return ", ".join(costs) if not costs.is_empty() else "없음"


static func _settle_deal(g: Dictionary, t: Dictionary, deal: Dictionary) -> void:
	var def: Dictionary = definition("deals", deal["id"])
	if def.is_empty(): return
	var comm: String = deal["comm"]
	var ctx: Dictionary = {"from": deal["id"], "comm": comm, "vals": {}, "speaker": g["comms"][comm]["leader"]["name"], "witnesses": []}
	var who: String = str(t["COMM_NAME"][comm]) + particle(t["COMM_NAME"][comm], "과/와")
	var paid: bool = _can_pay(g, t, def["ask"])
	var list: Array = def["ask"] if paid else def["breach"]
	_apply_effs(g, t, list)
	apply_rest(g, t, list, ctx)
	C.journal(g, "%s의 거래를 %s: %s." % [who, "치렀다" if paid else "치르지 못했다", effect_text(t, list)], "deal" if paid else "bad")


static func content_followup_tick(g: Dictionary, t: Dictionary) -> void:
	var due_deals: Array = []
	for deal: Dictionary in g.get("contentDeals", []):
		if int(deal["due"]) <= int(g["seg"]): due_deals.append(deal)
	if not due_deals.is_empty():
		g["contentDeals"] = (g["contentDeals"] as Array).filter(func(deal: Dictionary) -> bool: return int(deal["due"]) > int(g["seg"]))
		for deal: Dictionary in due_deals: _settle_deal(g, t, deal)
	var due: Array = []
	for queued: Dictionary in g.get("contentQueue", []):
		if int(queued["at"]) <= int(g["seg"]): due.append(queued)
	if due.is_empty(): return
	g["contentQueue"] = (g["contentQueue"] as Array).filter(func(queued: Dictionary) -> bool: return int(queued["at"]) > int(g["seg"]))
	for queued: Dictionary in due: add_content_card(g, t, queued["id"], false, true)


static func _speaker(g: Dictionary, t: Dictionary, ev: Dictionary, card: Dictionary) -> Dictionary:
	var comm: String = card.get("comm", "")
	if comm != "" and (_comm(t, ev["speaker"]) or ev["speaker"] == "rep"): return {"name": g["comms"][comm]["leader"]["name"], "role": t["REP_ROLE"][comm], "comm": comm}
	if comm != "" and ev["speaker"] == "aide": return {"name": card.get("vals", {}).get("@aide", g["comms"][comm]["leader"]["name"]), "role": str(t["COMM_NAME"][comm]) + " 측근", "comm": comm}
	return {"name": SPEAKER_ROLE.get(ev["speaker"], ev["speaker"]), "role": ""}


static func _choice(label: String, effs: Array, special: String = "", journal_line: String = "") -> Dictionary:
	var out: Dictionary = {"id": "", "label": label, "effs": effs, "special": special, "witness": false}
	if journal_line != "": out["log"] = journal_line
	return out


static func _guard_costs(g: Dictionary, view: Dictionary, always: bool = false) -> Dictionary:
	var choices: Array = view["choices"].duplicate(true)
	var any_open: bool = false
	for choice: Dictionary in choices:
		var why: String = _shortfall(g, choice["effs"])
		if why != "": choice["disabled"] = why
		else: any_open = true
	if always or any_open: view["choices"] = choices
	return view


static func content_view(g: Dictionary, t: Dictionary, card: Dictionary) -> Dictionary:
	if card["kind"] == "content-deal": return deal_view(g, t, card)
	if card["kind"] != "content": return {}
	var ev: Dictionary = definition("events", card.get("text", ""))
	if ev.is_empty(): return {"title": "빈 서류", "body": "읽을 수 없는 사건: " + str(card.get("text", "")), "choices": [_choice("덮는다", [], "", "읽을 수 없는 사건 서류를 덮었다.")], "required": false}
	var vals: Dictionary = card.get("vals", {})
	var speaker: Dictionary = _speaker(g, t, ev, card)
	var comm: String = speaker.get("comm", "")
	var shown: Array = []
	for choice: Dictionary in ev["choices"]:
		if _all_hold(g, t, choice.get("requires", [])): shown.append(choice)
	if shown.is_empty(): shown = ev["choices"]
	var choices: Array = []
	for choice: Dictionary in shown:
		var out: Dictionary = _choice(fill_text(choice["label"], vals), to_effs(t, choice["effects"]), "content:" + str(choice["id"]))
		out["witness"] = not (choice["witnesses"] as Array).is_empty()
		for key: String in ["say", "why", "later"]:
			if str(choice.get(key, "")) != "": out[key] = fill_text(choice[key], vals)
		if choice.has("log"): out["log"] = fill_text(choice["log"], vals)
		choices.append(out)
	var view: Dictionary = {"title": t["COMM_NAME"][comm] if comm != "" else speaker["name"], "speaker": speaker, "body": fill_text(ev["body"], vals), "choices": choices, "required": true, "key": "content:" + str(ev["id"])}
	if comm != "": view["focus"] = comm
	return _guard_costs(g, view)


static func deal_view(g: Dictionary, t: Dictionary, card: Dictionary) -> Dictionary:
	var def: Dictionary = definition("deals", card.get("text", ""))
	var comm: String = card.get("comm", "tail")
	if def.is_empty(): return {"title": "빈 서류", "body": "읽을 수 없는 거래: " + str(card.get("text", "")), "choices": [_choice("덮는다", [], "", "읽을 수 없는 거래 서류를 덮었다.")], "required": false}
	var now: bool = int(def["deadline"]) <= 0
	var parts: Array[String] = []
	if str(def.get("say", "")) != "": parts.append(def["say"])
	parts.append_array(["요구: " + effect_text(t, def["ask"]), "기한: " + ("지금" if now else "%d구간 뒤" % int(def["deadline"])), "어기면: " + effect_text(t, def["breach"])])
	var comm_name: String = str(t["COMM_NAME"][comm])
	var accept: Array = to_effs(t, def["gives"])
	if now: accept.append_array(to_effs(t, def["ask"]))
	return _guard_costs(g, {"title": str(t["COMM_NAME"][comm]) + "의 거래", "speaker": {"name": g["comms"][comm]["leader"]["name"], "role": t["REP_ROLE"][comm], "comm": comm}, "body": ". ".join(parts) + ".", "choices": [_choice("받는다", accept, "content-deal:accept", ("%s의 거래를 받아 값을 치렀다." if now else "%s의 거래를 받고 값을 치르기로 했다.") % comm_name), _choice("거절한다", [], "content-deal:refuse", "%s이(가) 내민 사건 거래를 거절했다." % comm_name)], "required": true, "key": "content-deal:" + str(def["id"]), "focus": comm}, true)


## Generic effects and the one journal line remain in turn_cards.gd. Only extension effects live here.
static func content_choose(g: Dictionary, t: Dictionary, card: Dictionary, selected: Dictionary) -> void:
	var comm: String = card.get("comm", "tail")
	if card["kind"] == "content-deal":
		var def: Dictionary = definition("deals", card.get("text", ""))
		if def.is_empty() or selected["special"] != "content-deal:accept": return
		var ctx: Dictionary = {"from": def["id"], "comm": comm, "vals": {}, "speaker": g["comms"][comm]["leader"]["name"], "witnesses": []}
		apply_rest(g, t, def["gives"], ctx)
		if int(def["deadline"]) <= 0: apply_rest(g, t, def["ask"], ctx)
		else:
			if not g.has("contentDeals"): g["contentDeals"] = []
			g["contentDeals"].append({"id": def["id"], "comm": comm, "due": int(g["seg"]) + int(def["deadline"])})
		return
	if card["kind"] != "content" or not str(selected["special"]).begins_with("content:"): return
	var ev: Dictionary = definition("events", card.get("text", ""))
	if ev.is_empty(): return
	for choice: Dictionary in ev["choices"]:
		if "content:" + str(choice["id"]) != selected["special"]: continue
		var witnesses: Array = []
		for witness: Variant in choice["witnesses"]: witnesses.append(witness if witness is String else witness["person"])
		apply_rest(g, t, choice["effects"], {"from": str(ev["id"]) + "." + str(choice["id"]), "comm": comm, "vals": card.get("vals", {}), "speaker": _speaker(g, t, ev, card)["name"], "witnesses": witnesses})
		for id: String in choice["followups"]: _queue(g, t, id, 0)
		return
