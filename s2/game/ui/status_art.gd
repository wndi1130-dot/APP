static var _made: Dictionary = {}


## The key of the picture for a state: "<id>", "<id>_severe" or "<id>_faint".
static func key(id: String, severe: bool, faint: bool) -> String:
	if severe and SVG.has(id + "_severe"):
		return id + "_severe"
	if faint and SVG.has(id + "_faint"):
		return id + "_faint"
	return id


## The picture at `diameter` screen units (drawn at twice that, for a sharp edge).
static func texture(id: String, severe: bool, faint: bool, diameter: int) -> Texture2D:
	var k: String = key(id, severe, faint)
	if not SVG.has(k):
		return null
	var slot: String = "%s@%d" % [k, diameter]
	if not _made.has(slot):
		var img := Image.new()
		if img.load_svg_from_string(String(SVG[k]), diameter * 2.0 / BASE) != OK:
			return null
		_made[slot] = ImageTexture.create_from_image(img)
	return _made[slot]
