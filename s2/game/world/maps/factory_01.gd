const ENTRY_WEIGHTS: Dictionary = {"동쪽 거리": 1.0, "남쪽 야적장": 1.0, "서쪽 야적장": 0.5, "culvert_01": 1.0, "manhole_01": 0.3, "북쪽 변전길": 1.0, "서쪽 간선": 1.0, "동쪽 간선": 1.0, "manhole_02": 0.3}
const FIRST_ENTRY: String = "동쪽 거리"


static func build() -> Dictionary:
	var data: Dictionary = _build_plain()
	data["entry_names"] = ENTRY_NAMES.duplicate()
	data["entry_weights"] = ENTRY_WEIGHTS.duplicate()
	data["first_entry"] = FIRST_ENTRY
	return data
