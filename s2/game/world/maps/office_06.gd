# 배치 자료 끝

static func _build_south() -> Dictionary:
	var g := FieldGrid.new(WIDTH, SOUTH_HEIGHT)
	var up1 := FieldGrid.new(WIDTH, SOUTH_HEIGHT)
	var up2 := FieldGrid.new(WIDTH, SOUTH_HEIGHT)
	var cellar := FieldGrid.new(WIDTH, SOUTH_HEIGHT)
	up1.solid.fill(S.AIR)
	up2.solid.fill(S.AIR)
	cellar.solid.fill(S.BLOCK)
	cellar.opq.fill(1)
	var train_doors: Array = [Vector2i(34, 4), Vector2i(50, 4), Vector2i(66, 4), Vector2i(82, 4)]
	var data: Dictionary = {
		"grid": g, "levels": {-1: cellar, 0: g, 1: up1, 2: up2}, "stairs": [],
		"containers": {}, "spots": {}, "stoves": [], "entries": {}, "entry_gap": {},
		"entry_levels": {}, "buildings": [], "wagons": [],
		"train": Rect2i(16, 1, 80, 3), "platform": Rect2i(16, 4, 82, 6),
		"unload": Rect2i(16, 4, 82, 3), "train_cars": [],
		"spawns": {"squad": [Vector2i(50, 6), Vector2i(48, 7), Vector2i(52, 7), Vector2i(50, 8)],
			"train_door": train_doors.duplicate(), "dead_street": [], "dead_levels": []},
		"labels": [], "trees": [], "low_blocks": [], "upper_rects": [], "lights": [],
		"hole_faces": {}, "manholes": {}, "manhole_levels": {}, "sewer_names": {}, "zone_names": {},
		"anchors": {"horde_home": Vector2i(50, 10), "whistle": Vector2i(90, 4),
			"flee_exit": Vector2i(120 if WIDTH > 150 else 102, SOUTH_HEIGHT - 1), "engine": Vector2i(92, 2)},
		"place_id": PLACE_ID, "place_kind": "office",
		"bands": {"lower": Rect2i(-4, 4, 120, 26).intersection(Rect2i(0, 0, WIDTH, SOUTH_HEIGHT))},
		"train_doors": {"lower": train_doors}, "crossings": [],
		"barricade_slots": [], "interior_kind_slots": [], "props": [],
	}
	for row in PLAN["zones"]:
		var r: Rect2i = _rect(row[0])
		data["zone_names"][row[1]] = row[2]
		for y in range(r.position.y, r.end.y):
			for x in range(r.position.x, r.end.x):
				g.zone[g.index(Vector2i(x, y))] = row[1]
	for id in range(PLAN["buildings"].size()):
		var b: Dictionary = PLAN["buildings"][id]
		var r: Rect2i = _rect(b["rect"])
		data["buildings"].append({"id": id, "name": b["name"], "rect": r, "warm": false, "window_broken": false})
		data["labels"].append({"text": b["name"], "cell": r.position + Vector2i(2, 2)})
	for op in PLAN["ops"]:
		var lg: FieldGrid = data["levels"][int(op[1])]
		var r: Rect2i = _rect(op[2])
		match String(op[0]):
			"floor":
				_fill_floor(lg, r, int(op[3]))
			"wall":
				_fill_solid(lg, r, S.WALL)
			"shell":
				_rooms(lg, int(op[3]), r, F.GRAVEL if int(op[1]) < 0 else F.WOOD)
				if int(op[1]) > 0:
					data["upper_rects"].append({"building": int(op[3]), "rect": r})
			"clear":
				_fill_floor(lg, r, int(op[3]))
				_fill_solid(lg, r, int(op[5]))
				if int(op[1]) > 0 and int(op[4]) >= 0 and int(op[5]) == S.NONE:
					var bridge: Dictionary = PLAN["buildings"][int(op[4])]
					if r == _rect(bridge["rect"]):
						data["upper_rects"].append({"building": int(op[4]), "rect": r})
				for y in range(r.position.y, r.end.y):
					for x in range(r.position.x, r.end.x):
						lg.building[lg.index(Vector2i(x, y))] = int(op[4])
	for row in PLAN["doors"]:
		var lg: FieldGrid = data["levels"][int(row[0])]
		_door(lg, _cell(row[1]), int(row[2]), String(row[3]))
	for row in PLAN["windows"]:
		var lg: FieldGrid = data["levels"][int(row[0])]
		var c: Vector2i = _cell(row[1])
		if lg.solid_at(c) == S.WALL:
			lg.set_solid(c, S.WINDOW)
			lg.windows[c] = {"broken": false, "glass": false, "building": int(row[2]), "cell": c}
	# The north snow row is kept plain; railway floors are painted after streets.
	_fill_floor(g, Rect2i(0, 0, WIDTH, 1), F.SNOW)
	_fill_floor(g, Rect2i(0, 1, WIDTH, 3), F.RAIL)
	_fill_solid(g, data["train"], S.BLOCK)
	_fill_floor(g, data["platform"], F.PLATFORM)
	for raw in PLAN["props"]:
		var p: Dictionary = raw.duplicate(true)
		var r: Rect2i = _rect(raw["rect"])
		p["rect"] = r
		data["props"].append(p)
		if int(p["level"]) != 0:
			continue
		match String(p["solid"]):
			"low":
				_fill_solid(g, r, S.LOW)
				if p["kind"] != "water":
					data["low_blocks"].append(r)
			"wall":
				_fill_solid(g, r, S.WALL)
			"tree":
				_fill_solid(g, r, S.BLOCK)
				data["trees"].append(r.position)
		if p["kind"] == "water":
			_fill_floor(g, r, F.ICE)
	for row in PLAN["stairs"]:
		data["stairs"].append({"cell": _cell(row[0]), "low": int(row[1]), "high": int(row[2]), "ladder": false})
	for i in range(PLAN["containers"].size()):
		var raw: Dictionary = PLAN["containers"][i]
		var id: String = "box_%03d" % i
		data["containers"][id] = {"id": id, "name": raw["name"], "cell": _cell(raw["cell"]),
			"building": int(raw["building"]), "search": 6.0, "items": raw["items"].duplicate(),
			"locked": bool(raw["locked"]), "level": int(raw["level"]), "searched": false}
	for name: String in PLAN["entries"]:
		var list: Array = []
		for raw in PLAN["entries"][name]:
			list.append(_cell(raw))
		data["entries"][name] = list
		data["entry_gap"][name] = float(PLAN["gaps"][name])
	for name: String in PLAN["holes"]:
		var c: Vector2i = _cell(PLAN["holes"][name])
		data["manholes"][name] = c
		data["sewer_names"][name] = PLAN["sewer_names"][name]
		data["labels"].append({"text": "맨홀" if name.begins_with("manhole_") else "배수구", "cell": c + Vector2i(0, -1)})
	for raw in PLAN["slots"]:
		data["barricade_slots"].append(_cell(raw))
	for zone: String in PLAN["deep"]:
		data["interior_kind_slots"].append({"zone": zone, "kinds": ["empty", "raiders", "nest", "beasts"]})
	for raw in PLAN["dead"]:
		data["spawns"]["dead_street"].append(_cell(raw))
	data["spots"]["work_site"] = {"kind": "work_site", "cell": _cell(PLAN["work"]),
		"name": "물자 작업 구역", "state": "closed", "zone_rect": Rect2i(_cell(PLAN["work"]) - Vector2i(3, 3), Vector2i(7, 7))}
	data["spots"]["salvage_tools"] = {"kind": "salvage", "cell": _cell(PLAN["work"]) + Vector2i(1, 0),
		"name": "작업대 연장", "material": "scrap", "amount": 2, "state": "intact"}
	_train_lights(data)
	for lv: int in data["levels"]:
		var lg: FieldGrid = data["levels"][lv]
		if lv != 0:
			lg.zone = g.zone.duplicate()
		lg.refresh_paths()
	return data


static func _cell(raw: Array) -> Vector2i:
	return Vector2i(int(raw[0]), int(raw[1]))


static func _rect(raw: Array) -> Rect2i:
	return Rect2i(int(raw[0]), int(raw[1]), int(raw[2]), int(raw[3]))


static func _fill_floor(g: FieldGrid, r: Rect2i, kind: int) -> void:
	for y in range(r.position.y, r.end.y):
		for x in range(r.position.x, r.end.x):
			g.floor[g.index(Vector2i(x, y))] = kind


static func _fill_solid(g: FieldGrid, r: Rect2i, kind: int) -> void:
	for y in range(r.position.y, r.end.y):
		for x in range(r.position.x, r.end.x):
			g.set_solid(Vector2i(x, y), kind)


static func _rooms(g: FieldGrid, id: int, r: Rect2i, floor_kind: int) -> void:
	_fill_floor(g, r, floor_kind)
	for y in range(r.position.y, r.end.y):
		for x in range(r.position.x, r.end.x):
			var c := Vector2i(x, y)
			g.building[g.index(c)] = id
			var edge: bool = x == r.position.x or x == r.end.x - 1 or y == r.position.y or y == r.end.y - 1
			g.set_solid(c, S.WALL if edge else S.NONE)


static func _door(g: FieldGrid, c: Vector2i, id: int, state: String) -> void:
	g.set_solid(c, S.DOOR)
	g.doors[c] = {"state": state, "hp": 8, "building": id, "cell": c}


static func _train_lights(data: Dictionary) -> void:
	for k in range(5):
		var r := Rect2i(16 + k * 16, 1, 16, 3)
		data["train_cars"].append({"rect": r, "kind": "car" if k < 4 else "engine"})
		if k == 4:
			data["lights"].append({"id": "firebox", "kind": "firebox", "cell": Vector2i(r.position.x + 2, 4),
				"side": Vector2i(0, 1), "strength": 0.8, "falls": 0.8, "reach": 4.0, "when": "always", "from_min": 0})
		else:
			for w in range(4):
				data["lights"].append({"id": "car%d_window%d" % [k + 1, w + 1], "kind": "car_window",
					"cell": Vector2i(r.position.x + 3 + w * 3, 4), "side": Vector2i(0, 1),
					"strength": 1.0, "falls": 0.6, "reach": 3.0, "when": "dusk", "from_min": 890})



