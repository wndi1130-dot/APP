	var data: Dictionary = _build_south()
	# 여기까지는 옛 좌표(열차가 맨 위 y 1~3), 아래부터는 새 좌표(열차 y 46~48)
	data = MapShift.shift_rows(data, 45)
	assert(data["train"] == Rect2i(16, 46, 80, 3))
	assert(data["grid"].height == HEIGHT)
	_add_north(data)
	for lv: int in data["levels"]:
		var lg: FieldGrid = data["levels"][lv]
		lg.refresh_paths()
	return data


static func _add_north(data: Dictionary) -> void:
	var g: FieldGrid = data["grid"]
	# 격자 사전의 키와 문 안에 든 칸 주소를 같은 새 좌표로 맞춘다.
	for lv: int in data["levels"]:
		var shifted: FieldGrid = data["levels"][lv]
		for c: Vector2i in shifted.doors:
			shifted.doors[c]["cell"] = c
		for c: Vector2i in shifted.windows:
			shifted.windows[c]["cell"] = c
	var first_id: int = data["buildings"].size()
	data["bands"]["upper"] = Rect2i(-4, 24, 120, 22).intersection(Rect2i(0, 0, WIDTH, HEIGHT))
	data["train_doors"]["upper"] = []
	for lower: Vector2i in data["train_doors"]["lower"]:
		data["train_doors"]["upper"].append(Vector2i(lower.x, 45))
	for x: int in NORTH_CROSSINGS:
		data["crossings"].append({"cells": [Vector2i(x, 46), Vector2i(x, 47), Vector2i(x, 48)],
			"who": {"person": true, "zombie": false, "carrying": true, "wounded": false, "sled": false}})
	for row in NORTH["zones"]:
		data["zone_names"][row[1]] = row[2]
		var r: Rect2i = _rect(row[0])
		for lv: int in data["levels"]:
			var lg: FieldGrid = data["levels"][lv]
			for y in range(r.position.y, r.end.y):
				for x in range(r.position.x, r.end.x):
					lg.zone[lg.index(Vector2i(x, y))] = row[1]
	for i in range(NORTH["buildings"].size()):
		var b: Dictionary = NORTH["buildings"][i]
		var r: Rect2i = _rect(b["rect"])
		data["buildings"].append({"id": first_id + i, "name": b["name"], "rect": r, "warm": false, "window_broken": false})
		data["labels"].append({"text": b["name"], "cell": r.position + Vector2i(2, 2)})
	for op in NORTH["ops"]:
		var lg: FieldGrid = data["levels"][int(op[1])]
		var r: Rect2i = _rect(op[2])
		match String(op[0]):
			"floor":
				_fill_floor(lg, r, int(op[3]))
			"wall":
				_fill_solid(lg, r, S.WALL)
			"shell":
				var id: int = first_id + int(op[3])
				_rooms(lg, id, r, F.GRAVEL if int(op[1]) < 0 else F.WOOD)
				if int(op[1]) > 0:
					data["upper_rects"].append({"building": id, "rect": r})
	for row in NORTH["doors"]:
		_door(data["levels"][int(row[0])], _cell(row[1]), first_id + int(row[2]), String(row[3]))
	for row in NORTH["windows"]:
		var lg: FieldGrid = data["levels"][int(row[0])]
		var c: Vector2i = _cell(row[1])
		if lg.solid_at(c) == S.WALL:
			lg.set_solid(c, S.WINDOW)
			lg.windows[c] = {"broken": false, "glass": false, "building": first_id + int(row[2]), "cell": c}
	for raw in NORTH["props"]:
		var p: Dictionary = raw.duplicate(true)
		var r: Rect2i = _rect(raw["rect"])
		p["rect"] = r
		data["props"].append(p)
		if int(p["level"]) != 0:
			continue
		match String(p["solid"]):
			"low":
				_fill_solid(g, r, S.LOW)
				if p["kind"] == "water":
					_fill_floor(g, r, F.ICE)
				else:
					data["low_blocks"].append(r)
			"wall":
				_fill_solid(g, r, S.WALL)
			"tree":
				_fill_solid(g, r, S.BLOCK)
				data["trees"].append(r.position)
	for row in NORTH["stairs"]:
		data["stairs"].append({"cell": _cell(row[0]), "low": int(row[1]), "high": int(row[2]), "ladder": false})
	for i in range(NORTH["containers"].size()):
		var raw: Dictionary = NORTH["containers"][i]
		var id: String = "north_box_%03d" % i
		data["containers"][id] = {"id": id, "name": raw["name"], "cell": _cell(raw["cell"]),
			"building": first_id + int(raw["building"]) if int(raw["building"]) >= 0 else -1,
			"search": 6.0, "items": raw["items"].duplicate(), "locked": bool(raw["locked"]), "level": int(raw["level"]), "searched": false}
	for name: String in NORTH["entries"]:
		var list: Array = []
		for raw in NORTH["entries"][name]:
			list.append(_cell(raw))
		data["entries"][name] = list
		data["entry_gap"][name] = float(NORTH["gaps"][name])
	for name: String in NORTH["holes"]:
		data["manholes"][name] = _cell(NORTH["holes"][name])
		data["sewer_names"][name] = NORTH["sewer_names"][name]
	for c in NORTH["slots"]:
		data["barricade_slots"].append(_cell(c))
	for zone: String in NORTH["deep"]:
		data["interior_kind_slots"].append({"zone": zone, "kinds": ["empty", "raiders", "nest", "beasts"]})
	# 화차는 문이 열린 화물차이며 사람을 태우는 자리는 없다.
	for raw in NORTH.get("wagons", []):
		var wagon: Dictionary = raw.duplicate(true)
		var r: Rect2i = _rect(raw["rect"])
		wagon["rect"] = r
		wagon["work"] = _cell(raw["work"])
		data["wagons"].append(wagon)
		_fill_solid(g, r, S.BLOCK)
		_fill_floor(g, r, F.RAIL)
	_fill_solid(g, Rect2i(16, 43, 80, 3), S.NONE)


## 무전 문장에 쓰는 들어오는 길의 이름, 길마다의 비중, 첫 물결이 오는 길.
const ENTRY_NAMES: Dictionary = {"manhole_01": "첫째 맨홀", "manhole_02": "둘째 맨홀", "manhole_03": "셋째 맨홀", "서쪽 큰길": "서쪽 큰길", "동쪽 큰길": "동쪽 큰길", "남쪽 둘레길": "남쪽 둘레길", "서쪽 둘레길": "서쪽 둘레길", "동쪽 선로": "동쪽 선로", "창고길 서단": "창고길 서단", "하역길 북단": "하역길 북단", "물자길 동단": "물자길 동단", "manhole_04": "넷째 맨홀"}
const ENTRY_WEIGHTS: Dictionary = {"manhole_01": 0.3, "manhole_02": 0.3, "manhole_03": 0.3, "서쪽 큰길": 1.0, "동쪽 큰길": 1.0, "남쪽 둘레길": 0.5, "서쪽 둘레길": 0.5, "동쪽 선로": 1.0, "창고길 서단": 1.0, "하역길 북단": 1.0, "물자길 동단": 1.0, "manhole_04": 0.3}
const FIRST_ENTRY: String = "서쪽 큰길"


static func build() -> Dictionary:
	var data: Dictionary = _build_plain()
	data["entry_names"] = ENTRY_NAMES.duplicate()
	data["entry_weights"] = ENTRY_WEIGHTS.duplicate()
	data["first_entry"] = FIRST_ENTRY
	return data
