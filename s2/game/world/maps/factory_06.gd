static func _build_plain() -> Dictionary:
	var data := _build_south()
	# 여기까지는 옛 좌표(열차가 맨 위 y 1~3), 아래부터는 새 좌표(열차 y 46~48)
	data = MapShift.shift_rows(data, 45)
	assert(data["train"] == Rect2i(16, 46, 80, 3))
	assert(data["grid"].height == HEIGHT)
	# 이동한 격자의 문과 창도 자기 칸을 가리키게 한다.
	for lv in data["levels"]:
		var shifted: FieldGrid = data["levels"][lv]
		for c: Vector2i in shifted.doors:
			shifted.doors[c] = shifted.doors[c].duplicate()
			shifted.doors[c]["cell"] = c
		for c: Vector2i in shifted.windows:
			shifted.windows[c] = shifted.windows[c].duplicate()
			shifted.windows[c]["cell"] = c
	_build_north(data)
	for lv in data["levels"]:
		var lg: FieldGrid = data["levels"][lv]
		if lv != 0:
			lg.zone = data["grid"].zone.duplicate()
		lg.refresh_paths()
	return data

static func _build_north(data: Dictionary) -> void:
	var g: FieldGrid = data["grid"]
	var base: int = data["buildings"].size()
	data["zone_names"].merge(NORTH["zone_names"])
	for row in NORTH["zones"]:
		var r := _rect(row[1])
		for y in range(r.position.y, r.end.y):
			for x in range(r.position.x, r.end.x):
				g.zone[g.index(Vector2i(x, y))] = row[0]
	for row in NORTH["floors"]:
		_fill_floor(g, _rect(row[0]), int(row[1]))
	for i in range(NORTH["buildings"].size()):
		var row: Array = NORTH["buildings"][i]
		data["buildings"].append({"id": base + i, "name": row[0], "rect": _rect(row[1]), "warm": false, "window_broken": false})
	for row in NORTH["surfaces"]:
		var lg: FieldGrid = data["levels"][int(row[1])]
		_surface(lg, base + int(row[0]), _rect(row[2]), int(row[3]))
		if int(row[1]) > 0:
			data["upper_rects"].append({"building": base + int(row[0]), "rect": _rect(row[2])})
	for row in NORTH["walls"]:
		_fill_solid(data["levels"][int(row[0])], _rect(row[1]), S.WALL)
	for row in NORTH["voids"]:
		_fill_solid(data["levels"][int(row[0])], _rect(row[1]), int(row[2]))
	for row in NORTH["doors"]:
		_door(data["levels"][int(row[0])], Vector2i(row[1], row[2]), base + int(row[3]), row[4])
	for row in NORTH["windows"]:
		var lg: FieldGrid = data["levels"][int(row[0])]
		var c := Vector2i(row[1], row[2])
		lg.set_solid(c, S.WINDOW)
		lg.windows[c] = {"broken": false, "glass": false, "building": base + int(row[3]), "cell": c}
	for row in NORTH["stairs"]:
		data["stairs"].append({"cell": Vector2i(row[0], row[1]), "low": int(row[2]), "high": int(row[3]), "ladder": false})
	for row in NORTH["props"]:
		var p: Dictionary = {"kind": row[0], "rect": _rect(row[1]), "solid": row[2], "facing": int(row[3]), "note": row[4], "level": int(row[5])}
		data["props"].append(p)
		if p["level"] != 0:
			continue
		if p["kind"] == "water":
			_fill_solid(g, p["rect"], S.LOW)
			_fill_floor(g, p["rect"], F.ICE)
		elif p["solid"] == "low":
			_fill_solid(g, p["rect"], S.LOW)
			data["low_blocks"].append(p["rect"])
		elif p["solid"] == "wall":
			_fill_solid(g, p["rect"], S.WALL)
	for row in NORTH["trees"]:
		var c := Vector2i(row[0], row[1])
		g.set_solid(c, S.BLOCK)
		data["trees"].append(c)
	for i in range(NORTH["containers"].size()):
		var row: Array = NORTH["containers"][i]
		var id := "north_store_%03d" % i
		data["containers"][id] = {"id": id, "name": row[0], "cell": Vector2i(row[1], row[2]), "level": int(row[3]), "building": base + int(row[4]) if int(row[4]) >= 0 else -1, "search": 6.0, "items": row[5].duplicate(), "locked": row[6], "searched": false}
	for row in NORTH["entries"]:
		var cells: Array = []
		for c in row[1]:
			cells.append(Vector2i(c[0], c[1]))
		data["entries"][row[0]] = cells
		data["entry_gap"][row[0]] = float(row[2])
	for row in NORTH["holes"]:
		var key: String = row[0]
		var c := Vector2i(row[1], row[2])
		data["manholes"][key] = c
		data["sewer_names"][key] = row[3]
		if key.begins_with("culvert_"):
			data["hole_faces"][key] = Vector2i(row[4], row[5])
		else:
			data["labels"].append({"text": "맨홀", "cell": c + Vector2i(0, -1)})
	for c in NORTH["barricades"]:
		data["barricade_slots"].append(Vector2i(c[0], c[1]))
	for key in NORTH["deep_zones"]:
		data["interior_kind_slots"].append({"zone": key, "kinds": ["empty", "raiders", "nest", "beasts"]})
	for row in NORTH["rooms"]:
		data["labels"].append({"text": row[3], "cell": _rect(row[2]).position, "level": int(row[1])})
	data["bands"]["upper"] = Rect2i(0, 24, 116, 22)
	data["train_doors"]["upper"] = []
	for c: Vector2i in data["train_doors"]["lower"]:
		data["train_doors"]["upper"].append(Vector2i(c.x, 45))
		data["barricade_slots"].append(Vector2i(c.x, 44))
		var lower := Vector2i(c.x, 50)
		if not data["barricade_slots"].has(lower):
			data["barricade_slots"].append(lower)
	for x in NORTH["crossings"]:
		data["crossings"].append({"cells": [Vector2i(x, 46), Vector2i(x, 47), Vector2i(x, 48)], "who": {"person": true, "zombie": false, "carrying": true, "wounded": false, "sled": false}})

static func _build_south() -> Dictionary:
	var g := FieldGrid.new(WIDTH, SOUTH_HEIGHT)
	var data: Dictionary = {
		"grid": g, "levels": {0: g, -1: _blank(S.BLOCK), 1: _blank(S.AIR), 2: _blank(S.AIR)},
		"stairs": [], "containers": {}, "spots": {}, "stoves": [], "entries": {},
		"entry_gap": {}, "entry_levels": {}, "buildings": [], "wagons": [],
		"train": Rect2i(16, 1, 80, 3), "platform": Rect2i(16, 4, 82, 6),
		"unload": Rect2i(16, 4, 82, 3), "train_cars": [], "spawns": {},
		"labels": [], "trees": [], "low_blocks": [], "upper_rects": [], "lights": [],
		"manholes": {}, "manhole_levels": {}, "sewer_names": {}, "anchors": {},
		"zone_names": PLAN["zone_names"].duplicate(), "place_id": PLACE_ID, "place_kind": "factory",
		"bands": {"lower": Rect2i(0, 4, 116, 26)}, "train_doors": {}, "crossings": [],
		"barricade_slots": [], "interior_kind_slots": [], "props": [], "hole_faces": {},
	}
	for row in PLAN["zones"]:
		var r := _rect(row[1])
		for y in range(r.position.y, r.end.y):
			for x in range(r.position.x, r.end.x):
				g.zone[g.index(Vector2i(x, y))] = row[0]
	for row in PLAN["floors"]:
		_fill_floor(g, _rect(row[0]), int(row[1]))
	_fill_floor(g, Rect2i(0, 1, WIDTH, 3), F.RAIL)
	_fill_floor(g, data["platform"], F.PLATFORM)
	_fill_solid(g, data["train"], S.BLOCK)
	for k in range(5):
		data["train_cars"].append({"rect": Rect2i(16 + k * 16, 1, 16, 3), "kind": "engine" if k == 4 else "car"})
	for i in range(PLAN["buildings"].size()):
		var row: Array = PLAN["buildings"][i]
		data["buildings"].append({"id": i, "name": row[0], "rect": _rect(row[1]), "warm": false, "window_broken": false})
	for row in PLAN["surfaces"]:
		var lg: FieldGrid = data["levels"][int(row[1])]
		_surface(lg, int(row[0]), _rect(row[2]), int(row[3]))
		if int(row[1]) > 0:
			data["upper_rects"].append({"building": int(row[0]), "rect": _rect(row[2])})
	for row in PLAN["walls"]:
		_fill_solid(data["levels"][int(row[0])], _rect(row[1]), S.WALL)
	for row in PLAN["voids"]:
		_fill_solid(data["levels"][int(row[0])], _rect(row[1]), int(row[2]))
	for row in PLAN["doors"]:
		_door(data["levels"][int(row[0])], Vector2i(row[1], row[2]), int(row[3]), row[4])
	for row in PLAN["windows"]:
		var lg: FieldGrid = data["levels"][int(row[0])]
		var c := Vector2i(row[1], row[2])
		lg.set_solid(c, S.WINDOW)
		lg.windows[c] = {"broken": false, "glass": false, "building": int(row[3]), "cell": c}
	for row in PLAN["stairs"]:
		data["stairs"].append({"cell": Vector2i(row[0], row[1]), "low": int(row[2]), "high": int(row[3]), "ladder": false})
	for row in PLAN["props"]:
		var p: Dictionary = {"kind": row[0], "rect": _rect(row[1]), "solid": row[2], "facing": int(row[3]), "note": row[4], "level": int(row[5])}
		data["props"].append(p)
		if p["level"] != 0:
			continue
		if p["kind"] == "water":
			_fill_solid(g, p["rect"], S.LOW)
			_fill_floor(g, p["rect"], F.ICE)
		elif p["solid"] == "low":
			_fill_solid(g, p["rect"], S.LOW)
			data["low_blocks"].append(p["rect"])
		elif p["solid"] == "wall":
			_fill_solid(g, p["rect"], S.WALL)
	for row in PLAN["trees"]:
		var c := Vector2i(row[0], row[1])
		g.set_solid(c, S.BLOCK)
		data["trees"].append(c)
	for i in range(PLAN["containers"].size()):
		var row: Array = PLAN["containers"][i]
		var id := "store_%03d" % i
		data["containers"][id] = {"id": id, "name": row[0], "cell": Vector2i(row[1], row[2]), "level": int(row[3]), "building": int(row[4]), "search": 6.0, "items": row[5].duplicate(), "locked": row[6], "searched": false}
	for row in PLAN["entries"]:
		var cells: Array = []
		for c in row[1]:
			cells.append(Vector2i(c[0], c[1]))
		data["entries"][row[0]] = cells
		data["entry_gap"][row[0]] = float(row[2])
	for row in PLAN["holes"]:
		var key: String = row[0]
		var c := Vector2i(row[1], row[2])
		data["manholes"][key] = c
		data["sewer_names"][key] = row[3]
		if key.begins_with("culvert_"):
			data["hole_faces"][key] = Vector2i(row[4], row[5])
		else:
			data["labels"].append({"text": "맨홀", "cell": c + Vector2i(0, -1)})
	for c in PLAN["barricades"]:
		data["barricade_slots"].append(Vector2i(c[0], c[1]))
	for key in PLAN["deep_zones"]:
		data["interior_kind_slots"].append({"zone": key, "kinds": ["empty", "raiders", "nest", "beasts"]})
	for row in PLAN["rooms"]:
		data["labels"].append({"text": row[3], "cell": _rect(row[2]).position, "level": int(row[1])})
	var doors: Array = [Vector2i(34, 4), Vector2i(50, 4), Vector2i(66, 4), Vector2i(82, 4)]
	data["train_doors"]["lower"] = doors.duplicate()
	data["spawns"] = {"squad": [Vector2i(50, 6), Vector2i(48, 7), Vector2i(52, 7), Vector2i(50, 8)], "train_door": doors, "dead_levels": [], "dead_yard": []}
	for c in PLAN["dead"]:
		data["spawns"]["dead_yard"].append(Vector2i(c[0], c[1]))
	var work: Array = PLAN["work"]
	data["spots"]["work_site"] = {"kind": "work_site", "cell": Vector2i(work[0], work[1]), "name": "작업 구역", "state": "closed", "zone_rect": Rect2i(work[2], work[3], work[4], work[5])}
	for i in range(PLAN["salvage"].size()):
		var c: Array = PLAN["salvage"][i]
		data["spots"]["salvage_%02d" % i] = {"kind": "salvage", "name": "정비 자재", "cell": Vector2i(c[0], c[1]), "material": "scrap", "amount": 2, "state": "intact"}
	data["anchors"] = {"horde_home": Vector2i(50, 10), "whistle": Vector2i(90, 4), "flee_exit": Vector2i(60, SOUTH_HEIGHT - 1), "engine": Vector2i(92, 2)}
	for lv in data["levels"]:
		var lg: FieldGrid = data["levels"][lv]
		if lv != 0:
			lg.zone = g.zone.duplicate()
		lg.refresh_paths()
	return data

static func _rect(a: Array) -> Rect2i:
	return Rect2i(int(a[0]), int(a[1]), int(a[2]), int(a[3]))

static func _blank(kind: int) -> FieldGrid:
	var g := FieldGrid.new(WIDTH, SOUTH_HEIGHT)
	g.solid.fill(kind)
	g.opq.fill(1 if kind == S.BLOCK else 0)
	return g

static func _fill_floor(g: FieldGrid, r: Rect2i, kind: int) -> void:
	for y in range(r.position.y, r.end.y):
		for x in range(r.position.x, r.end.x):
			g.floor[g.index(Vector2i(x, y))] = kind

static func _fill_solid(g: FieldGrid, r: Rect2i, kind: int) -> void:
	for y in range(r.position.y, r.end.y):
		for x in range(r.position.x, r.end.x):
			g.set_solid(Vector2i(x, y), kind)

static func _surface(g: FieldGrid, id: int, r: Rect2i, floor_kind: int) -> void:
	_fill_floor(g, r, floor_kind)
	for y in range(r.position.y, r.end.y):
		for x in range(r.position.x, r.end.x):
			var c := Vector2i(x, y)
			g.building[g.index(c)] = id
			g.set_solid(c, S.WALL if x == r.position.x or y == r.position.y or x == r.end.x - 1 or y == r.end.y - 1 else S.NONE)

static func _door(g: FieldGrid, c: Vector2i, id: int, state: String) -> void:
	g.set_solid(c, S.DOOR)
	g.doors[c] = {"state": state, "hp": 8, "building": id, "cell": c}



