const ENTRY_NAMES: Dictionary = {"북동 골목": "북동 골목", "남쪽 큰길": "남쪽 큰길", "동쪽 거리": "동쪽 거리", "남서 길": "남서 길", "culvert_01": "암거", "manhole_01": "첫째 맨홀", "북쪽 건재길": "북쪽 건재길", "서쪽 야적길": "서쪽 야적길", "동쪽 건재길": "동쪽 건재길", "manhole_02": "둘째 맨홀"}
const ENTRY_WEIGHTS: Dictionary = {"북동 골목": 0.5, "남쪽 큰길": 1.0, "동쪽 거리": 1.0, "남서 길": 0.5, "culvert_01": 1.0, "manhole_01": 0.3, "북쪽 건재길": 1.0, "서쪽 야적길": 1.0, "동쪽 건재길": 1.0, "manhole_02": 0.3}
const FIRST_ENTRY: String = "남쪽 큰길"


static func build() -> Dictionary:
	var data: Dictionary = _build_plain()
	data["entry_names"] = ENTRY_NAMES.duplicate()
	data["entry_weights"] = ENTRY_WEIGHTS.duplicate()
	data["first_entry"] = FIRST_ENTRY
	return data
