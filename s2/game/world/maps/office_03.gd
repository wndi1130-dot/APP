const ENTRY_NAMES: Dictionary = {"manhole_01": "첫째 맨홀", "manhole_02": "둘째 맨홀", "manhole_03": "셋째 맨홀", "서쪽 큰길": "서쪽 큰길", "동쪽 큰길": "동쪽 큰길", "서쪽 거리": "서쪽 거리", "동쪽 골목": "동쪽 골목", "동쪽 선로": "동쪽 선로", "제설 갈래 서단": "제설 갈래 서단", "제설 주도로 북단": "제설 주도로 북단", "소금 광 동쪽길": "소금 광 동쪽길", "manhole_04": "넷째 맨홀"}
const ENTRY_WEIGHTS: Dictionary = {"manhole_01": 0.3, "manhole_02": 0.3, "manhole_03": 0.3, "서쪽 큰길": 1.0, "동쪽 큰길": 1.0, "서쪽 거리": 0.5, "동쪽 골목": 0.5, "동쪽 선로": 1.0, "제설 갈래 서단": 1.0, "제설 주도로 북단": 1.0, "소금 광 동쪽길": 1.0, "manhole_04": 0.3}
const FIRST_ENTRY: String = "서쪽 큰길"


static func build() -> Dictionary:
	var data: Dictionary = _build_plain()
	data["entry_names"] = ENTRY_NAMES.duplicate()
	data["entry_weights"] = ENTRY_WEIGHTS.duplicate()
	data["first_entry"] = FIRST_ENTRY
	return data
