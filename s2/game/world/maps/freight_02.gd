const ENTRY_NAMES: Dictionary = {"west_road": "서쪽 길", "south_road": "남쪽 길", "east_track": "동쪽 선로", "east_yard": "동쪽 야적장", "manhole_01": "첫째 맨홀", "manhole_02": "둘째 맨홀", "drain_01": "첫째 배수구", "drain_02": "둘째 배수구", "서쪽 곡물길": "서쪽 곡물길", "북쪽 집하길": "북쪽 집하길", "동쪽 냉장길": "동쪽 냉장길"}
const ENTRY_WEIGHTS: Dictionary = {"west_road": 1.0, "south_road": 1.0, "east_track": 1.0, "east_yard": 1.0, "manhole_01": 0.3, "manhole_02": 0.3, "drain_01": 1.0, "drain_02": 1.0, "서쪽 곡물길": 1.0, "북쪽 집하길": 1.0, "동쪽 냉장길": 1.0}
const FIRST_ENTRY: String = "west_road"


static func build() -> Dictionary:
	var data: Dictionary = _build_plain()
	data["entry_names"] = ENTRY_NAMES.duplicate()
	data["entry_weights"] = ENTRY_WEIGHTS.duplicate()
	data["first_entry"] = FIRST_ENTRY
	return data
