const ENTRY_NAMES: Dictionary = {"manhole_01": "첫째 맨홀", "manhole_02": "둘째 맨홀", "manhole_03": "셋째 맨홀", "남쪽 큰길": "남쪽 큰길", "서쪽 거리": "서쪽 거리", "뒤 골목": "뒤 골목", "동쪽 선로": "동쪽 선로", "북쪽 큰길 서단": "북쪽 큰길 서단", "동쪽 마당 북단": "동쪽 마당 북단", "동쪽 하역길": "동쪽 하역길", "manhole_04": "넷째 맨홀"}
const ENTRY_WEIGHTS: Dictionary = {"manhole_01": 0.3, "manhole_02": 0.3, "manhole_03": 0.3, "남쪽 큰길": 1.0, "서쪽 거리": 1.0, "뒤 골목": 0.5, "동쪽 선로": 1.0, "북쪽 큰길 서단": 1.0, "동쪽 마당 북단": 1.0, "동쪽 하역길": 1.0, "manhole_04": 0.3}
const FIRST_ENTRY: String = "남쪽 큰길"


static func build() -> Dictionary:
	var data: Dictionary = _build_plain()
	data["entry_names"] = ENTRY_NAMES.duplicate()
	data["entry_weights"] = ENTRY_WEIGHTS.duplicate()
	data["first_entry"] = FIRST_ENTRY
	return data
