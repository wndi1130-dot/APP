const ENTRY_WEIGHTS: Dictionary = {"west_road": 1.0, "east_road": 1.0, "south_street": 1.0, "east_lane": 0.5, "east_track": 1.0, "manhole_01": 0.3, "manhole_02": 0.3, "plant_drain_01": 0.5, "서쪽 농원길": 1.0, "북쪽 고리길": 1.0, "동쪽 농원길": 1.0, "manhole_03": 0.3}
const FIRST_ENTRY: String = "west_road"


static func build() -> Dictionary:
	var data: Dictionary = _build_plain()
	data["entry_names"] = ENTRY_NAMES.duplicate()
	data["entry_weights"] = ENTRY_WEIGHTS.duplicate()
	data["first_entry"] = FIRST_ENTRY
	return data
