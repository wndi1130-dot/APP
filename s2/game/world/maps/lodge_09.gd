static func build() -> Dictionary:
	var g := FieldGrid.new(WIDTH, HEIGHT)
	var train := _rect(PLAN["train"])
	var data := {
		"grid": g, "levels": {0: g}, "stairs": [],
		"containers": {}, "spots": {}, "stoves": [], "entries": {},
		"buildings": [], "wagons": [], "train": train,
		"platform": Rect2i(train.position.x, train.end.y, 80, 3),
		"spawns": {}, "labels": [], "trees": [], "low_blocks": [],
		"upper_rects": [], "train_cars": [], "lights": [],
		"manholes": {}, "sewer_names": {}, "manhole_levels": {},
		"entry_levels": {}, "entry_gap": {},
		"entry_names": ENTRY_NAMES.duplicate(), "entry_weights": ENTRY_WEIGHTS.duplicate(), "first_entry": FIRST_ENTRY, "zone_names": ZONE_NAMES.duplicate(),
		"unload": Rect2i(train.position.x, train.position.y - 3, 80, 9),
		"place_id": PLACE_ID, "place_kind": "lodge",
		"bands": {}, "train_doors": {"upper": [], "lower": []},
		"crossings": [], "barricade_slots": [], "props": [],
		"interior_kind_slots": [{"zone": "C", "kinds": ["empty", "raiders", "nest", "beasts"]}],
	}
	for level in PLAN["levels"]:
		if level == 0:
			continue
		var lg := FieldGrid.new(WIDTH, HEIGHT)
		lg.solid.fill(S.BLOCK if level < 0 else S.AIR)
		data["levels"][level] = lg
	# Paint rows: level, x, y, width, height, floor, solid, building, zone.
	# -1 leaves floor/solid unchanged; -2 leaves building unchanged; "_" leaves zone unchanged.
	for row in PLAN["paint"]:
		var lg: FieldGrid = data["levels"][row[0]]
		for y in range(row[2], row[2] + row[4]):
			for x in range(row[1], row[1] + row[3]):
				var c := Vector2i(x, y)
				var i := lg.index(c)
				if row[5] >= 0:
					lg.floor[i] = row[5]
				if row[6] >= 0:
					lg.set_solid(c, row[6])
				if row[7] >= -1:
					lg.building[i] = row[7]
				if row[8] != "_":
					lg.zone[i] = row[8]
	for side in ["upper", "lower"]:
		data["bands"][side] = _rect(PLAN["bands"][side])
		for point in PLAN["train_doors"][side]:
			data["train_doors"][side].append(_cell(point))
	for row in PLAN["buildings"]:
		data["buildings"].append({"id": row[0], "name": row[1],
			"rect": Rect2i(row[2], row[3], row[4], row[5]),
			"warm": row[0] == 0, "window_broken": false})
	for row in PLAN["doors"]:
		var lg: FieldGrid = data["levels"][row[0]]
		var c := Vector2i(row[1], row[2])
		lg.set_solid(c, S.DOOR)
		lg.doors[c] = {"state": row[3], "hp": 8, "building": row[4], "cell": c}
	for row in PLAN["windows"]:
		var lg: FieldGrid = data["levels"][row[0]]
		var c := Vector2i(row[1], row[2])
		lg.set_solid(c, S.WINDOW)
		lg.windows[c] = {"broken": false, "glass": false, "building": row[3], "cell": c}
	for row in PLAN["low_blocks"]:
		var r := _rect(row)
		data["low_blocks"].append(r)
		for y in range(r.position.y, r.end.y):
			for x in range(r.position.x, r.end.x):
				g.set_solid(Vector2i(x, y), S.LOW)
	for row in PLAN["stoves"]:
		var c := Vector2i(row[1], row[2])
		var lg: FieldGrid = data["levels"][row[0]]
		lg.set_solid(c, S.LOW)
		data["stoves"].append({"cell": c, "building": row[3],
			"lit": true, "upstairs": row[0] > 0, "level": row[0]})
	for point in PLAN["trees"]:
		var c := _cell(point)
		g.set_solid(c, S.BLOCK)
		data["trees"].append(c)
	for row in PLAN["stairs"]:
		data["stairs"].append({"cell": Vector2i(row[0], row[1]),
			"low": row[2], "high": row[3], "ladder": false})
	for row in PLAN["upper_rects"]:
		data["upper_rects"].append({"building": row[0],
			"rect": Rect2i(row[1], row[2], row[3], row[4])})
	for row in PLAN["containers"]:
		data["containers"][row[0]] = {"id": row[0], "name": row[1],
			"cell": Vector2i(row[2], row[3]), "building": row[4],
			"search": 6.0 if row[6] < 0 else 4.0,
			"items": row[5].duplicate(), "locked": false,
			"level": row[6], "searched": false}
	for row in PLAN["spots"]:
		data["spots"][row[0]] = {"kind": "salvage", "name": row[1],
			"cell": Vector2i(row[2], row[3]), "material": "wood",
			"amount": row[4], "state": "intact", "level": 0}
	for row in PLAN["labels"]:
		data["labels"].append({"text": row[0],
			"cell": Vector2i(row[1], row[2]), "level": row[3]})
	for row in PLAN["entries"]:
		var cells: Array[Vector2i] = []
		for point in row[2]:
			cells.append(_cell(point))
		data["entries"][row[0]] = cells
		data["entry_gap"][row[0]] = row[1]
	for key in PLAN["spawns"]:
		var cells: Array[Vector2i] = []
		for point in PLAN["spawns"][key]:
			cells.append(_cell(point))
		data["spawns"][key] = cells
	data["spawns"]["dead_levels"] = []
	for point in PLAN["slots"]:
		data["barricade_slots"].append(_cell(point))
	for row in PLAN["crossings"]:
		var cells: Array[Vector2i] = []
		for point in row:
			cells.append(_cell(point))
		data["crossings"].append({"cells": cells, "who": {
			"person": true, "zombie": true, "carrying": true, "wounded": true, "sled": true}})
	for k in range(CAR_COUNT + 1):
		var r := Rect2i(train.position.x + k * CAR_LEN, train.position.y, CAR_LEN, 3)
		data["train_cars"].append({"rect": r, "kind": "car" if k < CAR_COUNT else "engine"})
		if k == CAR_COUNT:
			data["lights"].append({"id": "firebox", "kind": "firebox",
				"cell": Vector2i(r.position.x + 2, r.end.y - 1), "side": Vector2i.DOWN,
				"strength": 0.8, "falls": 0.8, "reach": 4.0, "when": "always", "from_min": 0})
			continue
		for side in [-1, 1]:
			for w in range(CAR_WINDOWS):
				data["lights"].append({"id": "car%d_window%d_side%d" % [k, w, side],
					"kind": "car_window",
					"cell": Vector2i(r.position.x + 3 + w * 3, r.position.y if side < 0 else r.end.y - 1),
					"side": Vector2i(0, side), "strength": 1.0, "falls": 0.6,
					"reach": 3.0, "when": "dusk", "from_min": DUSK_MIN})
	for row in PLAN["props"]:
		data["props"].append({"kind": row[0], "rect": Rect2i(row[1], row[2], row[3], row[4]),
			"solid": row[5], "facing": row[6], "note": row[7], "level": row[8]})
	for lg in data["levels"].values():
		lg.refresh_paths()
	return data


static func _cell(row: Array) -> Vector2i:
	return Vector2i(row[0], row[1])


static func _rect(row: Array) -> Rect2i:
	return Rect2i(row[0], row[1], row[2], row[3])
