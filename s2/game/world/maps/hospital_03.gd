static func _build_plain() -> Dictionary:
	var data := _build_south()
	# 여기까지는 옛 좌표(열차가 맨 위 y 1~3), 아래부터는 새 좌표(열차 y 46~48)
	data = MapShift.shift_rows(data, 45)
	assert(data["train"] == Rect2i(16, 46, 80, 3))
	assert(data["grid"].height == HEIGHT)
	_build_north(data)
	for level: int in data["levels"]:
		var g: FieldGrid = data["levels"][level]
		if level != 0:
			g.zone = data["grid"].zone.duplicate()
		# 이동 함수가 복사한 문과 창의 내부 위치도 새 격자 키에 맞춘다.
		for c: Vector2i in g.doors:
			if g.doors[c].has("cell"):
				g.doors[c]["cell"] = c
		for c: Vector2i in g.windows:
			if g.windows[c].has("cell"):
				g.windows[c]["cell"] = c
		g.refresh_paths()
	return data


static func _build_north(data: Dictionary) -> void:
	var g: FieldGrid = data["grid"]
	var first_id: int = data["buildings"].size()
	data["zone_names"].merge(NORTH_ZONE_NAMES)
	data["bands"]["upper"] = Rect2i(0, 24, 116, 22)
	data["train_doors"]["upper"] = []
	for c: Vector2i in data["train_doors"]["lower"]:
		data["train_doors"]["upper"].append(Vector2i(c.x, 45))
		data["barricade_slots"].append(Vector2i(c.x, 44))
		data["barricade_slots"].append(Vector2i(c.x, 50))
	for x: int in NORTH_CROSSINGS:
		data["crossings"].append({
			"cells": [Vector2i(x, 46), Vector2i(x, 47), Vector2i(x, 48)],
			"who": {"person": true, "zombie": false, "carrying": true, "wounded": false, "sled": false}
		})
	for row: Array in NORTH["floors"]:
		_floor(g, _rect(row), int(row[4]))
	for row: Array in NORTH["zones"]:
		_zone(g, _rect(row), String(row[4]))
	for index: int in range(NORTH["buildings"].size()):
		var row: Array = NORTH["buildings"][index]
		data["buildings"].append({"id": first_id + index, "name": row[0], "rect": _rect(row, 1),
			"warm": false, "window_broken": false})
	for row: Array in NORTH["shells"]:
		var level: int = int(row[0])
		var id: int = first_id + int(row[1])
		var r := _rect(row, 2)
		_shell(data["levels"][level], id, r, level)
		if level == 0:
			_zone(g, r, String(NORTH["buildings"][int(row[1])][7]))
		elif level > 0:
			data["upper_rects"].append({"building": id, "rect": r})
	for row: Array in NORTH["walls"]:
		_solid(data["levels"][int(row[0])], _rect(row, 2), S.WALL)
	for row: Array in NORTH["openings"]:
		_solid(data["levels"][int(row[0])], _rect(row, 1), S.NONE)
	for row: Array in NORTH["windows"]:
		var lg: FieldGrid = data["levels"][int(row[0])]
		var c := _cell(row, 2)
		lg.set_solid(c, S.WINDOW)
		lg.windows[c] = {"broken": false, "glass": false, "building": first_id + int(row[1]), "cell": c}
	for row: Array in NORTH["doors"]:
		var lg: FieldGrid = data["levels"][int(row[0])]
		var c := _cell(row, 2)
		lg.set_solid(c, S.DOOR)
		lg.doors[c] = {"state": row[4], "hp": 8, "building": first_id + int(row[1]), "cell": c}
	for row: Array in NORTH["stairs"]:
		data["stairs"].append({"cell": _cell(row), "low": int(row[2]), "high": int(row[3]), "ladder": false})
	for row: Array in NORTH["rooms"]:
		var c := Vector2i(int(row[3]) + floori(float(row[5]) * 0.5), int(row[4]) + floori(float(row[6]) * 0.5))
		data["labels"].append({"text": row[2], "cell": c, "level": int(row[0])})
	for row: Array in NORTH["props"]:
		var r := _rect(row, 1)
		var level: int = int(row[8])
		data["props"].append({"kind": row[0], "rect": r, "solid": row[5],
			"facing": int(row[6]), "note": row[7], "level": level})
		if level != 0:
			continue
		match String(row[5]):
			"low":
				_solid(g, r, S.LOW)
				if row[0] == "water":
					_floor(g, r, F.ICE)
				else:
					data["low_blocks"].append(r)
			"wall":
				_solid(g, r, S.WALL)
			"tree":
				_solid(g, r, S.BLOCK)
				data["trees"].append(r.position)
	for row: Array in NORTH["containers"]:
		var id: String = row[0]
		var building: int = int(row[4])
		if building >= 0:
			building += first_id
		data["containers"][id] = {"id": id, "name": row[1], "cell": _cell(row, 2),
			"building": building, "search": float(row[5]), "items": row[6].duplicate(),
			"locked": bool(row[7]), "level": int(row[8]), "searched": false}
	for row: Array in NORTH["entries"]:
		var entry_cells: Array[Vector2i] = []
		for c: Array in row[1]:
			entry_cells.append(_cell(c))
		data["entries"][row[0]] = entry_cells
		data["entry_gap"][row[0]] = float(row[2])
	for row: Array in NORTH["holes"]:
		var id: String = row[0]
		var c := _cell(row, 2)
		data["manholes"][id] = c
		data["sewer_names"][id] = row[1]
		data["entries"][id] = [c]
		data["entry_gap"][id] = float(row[5])
		data["labels"].append({"text": "맨홀", "cell": c})
	for row: Array in NORTH["gates"]:
		data["barricade_slots"].append(_cell(row))
	for zone: String in NORTH["deep_zones"]:
		data["interior_kind_slots"].append({"zone": zone, "kinds": ["empty", "raiders", "nest", "beasts"]})


# 이동 전 남쪽 기준. 회귀 시험도 이 좌표계를 대조한다.
static func _build_south() -> Dictionary:
	var g := FieldGrid.new(WIDTH, SOUTH_HEIGHT)
	var cellar := FieldGrid.new(WIDTH, SOUTH_HEIGHT)
	cellar.solid.fill(S.BLOCK)
	var first := FieldGrid.new(WIDTH, SOUTH_HEIGHT)
	first.solid.fill(S.AIR)
	var second := FieldGrid.new(WIDTH, SOUTH_HEIGHT)
	second.solid.fill(S.AIR)
	var data: Dictionary = {
		"grid": g, "levels": {-1: cellar, 0: g, 1: first, 2: second},
		"stairs": [], "containers": {}, "spots": {}, "stoves": [],
		"entries": {}, "entry_gap": {}, "entry_levels": {},
		"buildings": [], "wagons": [], "train": Rect2i(16, 1, 80, 3),
		"platform": Rect2i(16, 4, 82, 6), "unload": Rect2i(16, 4, 82, 3),
		"train_cars": [], "spawns": {}, "labels": [], "trees": [],
		"low_blocks": [], "upper_rects": [], "lights": [],
		"manholes": {}, "manhole_levels": {}, "sewer_names": {},
		"anchors": {"horde_home": Vector2i(50, 10), "whistle": Vector2i(90, 4),
			"flee_exit": Vector2i(WIDTH - 1, SOUTH_HEIGHT - 1), "engine": Vector2i(92, 2)},
		"zone_names": ZONE_NAMES.duplicate(),
		"place_id": PLACE_ID, "place_kind": "hospital",
		"bands": {"lower": Rect2i(0, 4, 116, 26)},
		"train_doors": {"lower": [Vector2i(34, 4), Vector2i(50, 4), Vector2i(66, 4)]},
		"crossings": [], "barricade_slots": [], "interior_kind_slots": [],
		"props": [], "hole_faces": {}
	}
	g.zone.fill("B")
	for row: Array in PLAN["floors"]:
		_floor(g, _rect(row), int(row[4]))
	for row: Array in PLAN["zones"]:
		_zone(g, _rect(row), String.chr(65 + int(row[4])))
	_floor(g, Rect2i(0, 1, WIDTH, 3), F.RAIL)
	_solid(g, data["train"], S.BLOCK)
	_floor(g, data["platform"], F.PLATFORM)
	_zone(g, data["bands"]["lower"], "A")
	for id: int in range(PLAN["buildings"].size()):
		var row: Array = PLAN["buildings"][id]
		data["buildings"].append({"id": id, "name": row[0], "rect": _rect(row, 1),
			"warm": false, "window_broken": false})
	for row: Array in PLAN["shells"]:
		var lg: FieldGrid = data["levels"][int(row[0])]
		var id: int = int(row[1])
		var r := _rect(row, 2)
		_shell(lg, id, r, int(row[0]))
		if int(row[0]) == 0:
			_zone(g, r, String.chr(65 + int(PLAN["buildings"][id][7])))
		elif int(row[0]) > 0:
			data["upper_rects"].append({"building": id, "rect": r})
	for row: Array in PLAN["walls"]:
		_solid(data["levels"][int(row[0])], _rect(row, 2), S.WALL)
	for row: Array in PLAN.get("openings", []):
		_solid(data["levels"][int(row[0])], _rect(row, 1), S.NONE)
	for row: Array in PLAN["windows"]:
		var lg: FieldGrid = data["levels"][int(row[0])]
		var c := _cell(row, 2)
		lg.set_solid(c, S.WINDOW)
		lg.windows[c] = {"broken": false, "glass": false, "building": int(row[1]), "cell": c}
	for row: Array in PLAN["doors"]:
		var lg: FieldGrid = data["levels"][int(row[0])]
		var c := _cell(row, 2)
		lg.set_solid(c, S.DOOR)
		lg.doors[c] = {"state": row[4], "hp": 8, "building": int(row[1]), "cell": c}
	for row: Array in PLAN["stairs"]:
		data["stairs"].append({"cell": _cell(row), "low": int(row[2]), "high": int(row[3]), "ladder": false})
	for row: Array in PLAN["rooms"]:
		var c := Vector2i(int(row[3]) + floori(float(row[5]) * 0.5), int(row[4]) + floori(float(row[6]) * 0.5))
		data["labels"].append({"text": row[2], "cell": c, "level": int(row[0])})
	for row: Array in PLAN["props"]:
		var r := _rect(row, 1)
		var level: int = int(row[8])
		var prop: Dictionary = {"kind": row[0], "rect": r, "solid": row[5],
			"facing": int(row[6]), "note": row[7], "level": level}
		data["props"].append(prop)
		if level != 0:
			continue
		match String(row[5]):
			"low":
				_solid(g, r, S.LOW)
				if row[0] == "water":
					_floor(g, r, F.ICE)
				else:
					data["low_blocks"].append(r)
			"wall":
				_solid(g, r, S.WALL)
			"tree":
				_solid(g, r, S.BLOCK)
				data["trees"].append(r.position)
	for row: Array in PLAN["containers"]:
		var id: String = row[0]
		data["containers"][id] = {"id": id, "name": row[1], "cell": _cell(row, 2),
			"building": int(row[4]), "search": float(row[5]), "items": row[6].duplicate(),
			"locked": bool(row[7]), "level": int(row[8]), "searched": false}
	for row: Array in PLAN["entries"]:
		var cells: Array[Vector2i] = []
		for c: Array in row[1]:
			cells.append(_cell(c))
		data["entries"][row[0]] = cells
		data["entry_gap"][row[0]] = float(row[2])
	for row: Array in PLAN["holes"]:
		var id: String = row[0]
		var c := _cell(row, 2)
		data["manholes"][id] = c
		data["sewer_names"][id] = row[1]
		data["entries"][id] = [c]
		data["entry_gap"][id] = float(row[5])
		if int(row[4]) != 0:
			data["manhole_levels"][id] = int(row[4])
			data["entry_levels"][id] = int(row[4])
		elif id.begins_with("manhole_"):
			data["labels"].append({"text": "맨홀", "cell": c})
		if id.begins_with("culvert_"):
			data["hole_faces"][id] = Vector2i(0, 1)
	for row: Array in PLAN["gates"]:
		data["barricade_slots"].append(_cell(row))
	for zone: String in PLAN["deep_zones"]:
		data["interior_kind_slots"].append({"zone": zone, "kinds": ["empty", "raiders", "nest", "beasts"]})
	var dead: Array[Vector2i] = []
	for row: Array in PLAN["spawns"]:
		dead.append(_cell(row))
	data["spawns"] = {
		"squad": [Vector2i(50, 6), Vector2i(48, 7), Vector2i(52, 7), Vector2i(50, 8)],
		"train_door": data["train_doors"]["lower"].duplicate(),
		"dead_street": dead, "dead_levels": []
	}
	data["spots"]["work_site"] = {"kind": "work_site", "name": "약품 싣는 터",
		"cell": Vector2i(62, 18), "zone_rect": Rect2i(50, 12, 25, 13), "state": "closed"}
	data["spots"]["cart_parts"] = {"kind": "salvage", "name": "손수레 부품", "cell": Vector2i(59, 16),
		"material": "scrap", "amount": 2, "state": "intact"}
	data["labels"].append({"text": "약품 싣는 터", "cell": Vector2i(60, 18)})
	for k: int in range(5):
		var r := Rect2i(16 + k * 16, 1, 16, 3)
		data["train_cars"].append({"rect": r, "kind": "engine" if k == 4 else "car"})
		if k == 4:
			data["lights"].append({"id": "firebox", "kind": "firebox", "cell": Vector2i(82, 4),
				"side": Vector2i(0, 1), "strength": 0.8, "falls": 0.8, "reach": 4.0, "when": "always", "from_min": 0})
		else:
			for w: int in range(4):
				data["lights"].append({"id": "window_%d_%d" % [k, w], "kind": "car_window",
					"cell": Vector2i(r.position.x + 3 + w * 3, 4), "side": Vector2i(0, 1),
					"strength": 1.0, "falls": 0.6, "reach": 3.0, "when": "dusk", "from_min": 890})
	for level: int in data["levels"]:
		var lg: FieldGrid = data["levels"][level]
		if level != 0:
			lg.zone = g.zone.duplicate()
		lg.refresh_paths()
	return data


static func _cell(row: Array, offset: int = 0) -> Vector2i:
	return Vector2i(int(row[offset]), int(row[offset + 1]))


static func _rect(row: Array, offset: int = 0) -> Rect2i:
	return Rect2i(int(row[offset]), int(row[offset + 1]), int(row[offset + 2]), int(row[offset + 3]))


static func _floor(g: FieldGrid, r: Rect2i, kind: int) -> void:
	for y: int in range(r.position.y, r.end.y):
		for x: int in range(r.position.x, r.end.x):
			var c := Vector2i(x, y)
			if g.inside(c):
				g.floor[g.index(c)] = kind


static func _solid(g: FieldGrid, r: Rect2i, kind: int) -> void:
	for y: int in range(r.position.y, r.end.y):
		for x: int in range(r.position.x, r.end.x):
			g.set_solid(Vector2i(x, y), kind)


static func _zone(g: FieldGrid, r: Rect2i, value: String) -> void:
	for y: int in range(r.position.y, r.end.y):
		for x: int in range(r.position.x, r.end.x):
			var c := Vector2i(x, y)
			if g.inside(c):
				g.zone[g.index(c)] = value


static func _shell(g: FieldGrid, id: int, r: Rect2i, level: int) -> void:
	for y: int in range(r.position.y, r.end.y):
		for x: int in range(r.position.x, r.end.x):
			var c := Vector2i(x, y)
			g.building[g.index(c)] = id
			g.floor[g.index(c)] = F.GRAVEL if level == -1 else F.WOOD
			var edge: bool = x == r.position.x or y == r.position.y or x == r.end.x - 1 or y == r.end.y - 1
			g.set_solid(c, S.WALL if edge else S.NONE)



## 무전 문장에 쓰는 들어오는 길의 이름, 길마다의 비중, 첫 물결이 오는 길.
const ENTRY_NAMES: Dictionary = {"west_road": "서쪽 길", "east_road": "동쪽 길", "east_street": "동쪽 거리", "west_lane": "서쪽 샛길", "east_track": "동쪽 선로", "manhole_01": "첫째 맨홀", "manhole_02": "둘째 맨홀", "cellar_drain_01": "지하실 배수구", "서쪽 관사길": "서쪽 관사길", "북쪽 관사길": "북쪽 관사길", "동쪽 관사길": "동쪽 관사길"}
const ENTRY_WEIGHTS: Dictionary = {"west_road": 1.0, "east_road": 1.0, "east_street": 1.0, "west_lane": 0.5, "east_track": 1.0, "manhole_01": 0.3, "manhole_02": 0.3, "cellar_drain_01": 0.5, "서쪽 관사길": 1.0, "북쪽 관사길": 1.0, "동쪽 관사길": 1.0}
const FIRST_ENTRY: String = "west_road"


static func build() -> Dictionary:
	var data: Dictionary = _build_plain()
	data["entry_names"] = ENTRY_NAMES.duplicate()
	data["entry_weights"] = ENTRY_WEIGHTS.duplicate()
	data["first_entry"] = FIRST_ENTRY
	return data
