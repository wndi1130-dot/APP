; Godot 4.7.2 stable. Generated graybox; no downloaded assets.
config_version=5

[application]
config/name="S2 Sulechow Graybox"
run/main_scene="res://scenes/boot.tscn"
config/features=PackedStringArray("4.7", "Mobile")

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0

[rendering]
renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
textures/vram_compression/import_etc2_astc=true
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.12, 0.12, 0.12, 1)

[physics]
common/physics_ticks_per_second=30

[shader_globals]
; Weather state for every fx shader. Only fx/fx_state.gd writes these
; (docs/design/briefs/shaders.md 3장).

fx_wet={
"type": "float",
"value": 0.0
}
fx_snow={
"type": "float",
"value": 0.0
}
fx_frost={
"type": "float",
"value": 0.0
}
fx_wind={
"type": "vec3",
"value": Vector3(1, 0, 0.4)
}
fx_tint={
"type": "color",
"value": Color(0.72, 0.74, 0.78, 1)
}
fx_flash={
"type": "float",
"value": 0.0
}
fx_fade={
"type": "float",
"value": 0.0
}
