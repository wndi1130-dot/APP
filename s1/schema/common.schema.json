{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:s1:schema:common",
  "title": "공통 값과 참조",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "description": "영문 소문자로 시작하고 소문자, 숫자, 밑줄을 쓴다. 가이드의 p_001 예시에 맞춰 숫자를 허용한다."
    },
    "community": {
      "type": "string",
      "enum": [
        "tail",
        "engine",
        "guard",
        "medtech",
        "front"
      ]
    },
    "state": {
      "type": "string",
      "enum": [
        "alive",
        "injured",
        "dead",
        "away"
      ]
    },
    "role": {
      "type": "string",
      "enum": [
        "captain",
        "deputy",
        "ration_officer",
        "rep",
        "aide",
        "faction_leader"
      ]
    },
    "profileFields": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "urn:s1:schema:common#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "name_original": {
          "type": "string",
          "minLength": 1
        },
        "name_lang": {
          "$ref": "urn:s1:schema:common#/$defs/nameLang"
        },
        "gender": {
          "type": "string",
          "enum": [
            "male",
            "female"
          ],
          "description": "폴란드어·체코어 과거형이 주어 성별을 따라서 번역에 쓴다(6.5). 화면엔 안 보인다."
        },
        "age": {
          "type": "integer",
          "minimum": 0,
          "maximum": 85
        },
        "community": {
          "$ref": "urn:s1:schema:common#/$defs/community"
        },
        "origin_tag": {
          "type": "string",
          "enum": [
            "original",
            "rescued"
          ]
        },
        "boarding": {
          "type": "string",
          "enum": [
            "depot",
            "bought",
            "force",
            "rescue",
            "refugee",
            "born"
          ]
        },
        "hometown": {
          "type": "string",
          "minLength": 1
        },
        "like": {
          "type": "string",
          "minLength": 1
        },
        "dislike": {
          "type": "string",
          "minLength": 1
        },
        "line": {
          "type": "string",
          "maxLength": 40,
          "pattern": "^[^\\r\\n]*$"
        },
        "state": {
          "$ref": "urn:s1:schema:common#/$defs/state"
        },
        "build": {
          "type": "string",
          "enum": [
            "thin",
            "average",
            "stocky"
          ],
          "description": "체격(character_creation 8장). S2에서 모두가 하나를 가진다."
        },
        "char_traits": {
          "type": "array",
          "items": {
            "$ref": "urn:s1:schema:common#/$defs/charTrait"
          },
          "maxItems": 3,
          "uniqueItems": true,
          "description": "몸·정치 특성(character_creation 9장). 지도자 성향 trait과 다르다."
        },
        "body": {
          "type": "object",
          "properties": {
            "stamina": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10
            },
            "melee": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10
            },
            "shooting": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10
            },
            "stealth": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10
            },
            "search": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10
            }
          },
          "required": [
            "stamina",
            "melee",
            "shooting",
            "stealth",
            "search"
          ],
          "additionalProperties": false,
          "description": "몸 능력 시작값(character_creation 4장·5.2)."
        },
        "job": {
          "$ref": "urn:s1:schema:common#/$defs/job"
        },
        "params": {
          "$ref": "urn:s1:schema:common#/$defs/textParams"
        },
        "plural": {
          "$ref": "urn:s1:schema:common#/$defs/textPlural"
        },
        "gender_of": {
          "$ref": "urn:s1:schema:common#/$defs/textGender"
        },
        "notes": {
          "$ref": "urn:s1:schema:common#/$defs/textNotes"
        }
      },
      "required": [
        "id",
        "name",
        "name_original",
        "gender",
        "age",
        "community",
        "origin_tag",
        "boarding",
        "hometown",
        "like",
        "dislike",
        "line",
        "state"
      ]
    },
    "charTrait": {
      "type": "string",
      "enum": [
        "cold_hardy",
        "night_eyes",
        "keen_ears",
        "light_feet",
        "tough",
        "fast_healer",
        "deft_hands",
        "packhorse",
        "quick_learner",
        "steady",
        "cold_weak",
        "short_breath",
        "jumpy",
        "old_wound",
        "slow_healer",
        "heavy_feet",
        "nearsighted",
        "clumsy_hands",
        "blood_shy",
        "habit",
        "silver_tongue",
        "known_family",
        "stern_face",
        "judge_of_people",
        "dark_past",
        "debt",
        "outsider"
      ]
    },
    "job": {
      "type": "string",
      "enum": [
        "engine_assistant",
        "fireman",
        "depot_mechanic",
        "merchant",
        "rail_official",
        "hunter",
        "police",
        "conscript",
        "forest_ranger",
        "doctor",
        "paramedic",
        "radio_operator",
        "miner",
        "farmer",
        "teacher",
        "laborer"
      ]
    },
    "nameLang": {
      "type": "string",
      "enum": [
        "pl",
        "de",
        "cz",
        "uk",
        "sk",
        "hu",
        "lt"
      ],
      "description": "이름을 뽑은 언어 풀(ref/names). S1b 수사 순위는 일반 묶음 pl·de·cz만 올리고, 이 칸이 없으면 올리지 않는다(s1b_dark_path 1.4)."
    },
    "condition": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "segment"
            },
            "min": {
              "type": "integer",
              "minimum": 0
            },
            "max": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "type",
            "min",
            "max"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "community"
            },
            "community": {
              "$ref": "urn:s1:schema:common#/$defs/community"
            },
            "metric": {
              "type": "string",
              "enum": [
                "warmth",
                "ration",
                "crowding",
                "exposure"
              ]
            },
            "operator": {
              "type": "string",
              "enum": [
                "lt",
                "lte",
                "eq",
                "gte",
                "gt"
              ]
            },
            "value": {
              "type": "number"
            }
          },
          "required": [
            "type",
            "community",
            "metric",
            "operator",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "flag"
            },
            "id": {
              "$ref": "urn:s1:schema:common#/$defs/id"
            },
            "value": {
              "type": [
                "boolean",
                "number",
                "string"
              ]
            }
          },
          "required": [
            "type",
            "id",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "person"
            },
            "id": {
              "$ref": "urn:s1:schema:common#/$defs/id"
            },
            "state": {
              "$ref": "urn:s1:schema:common#/$defs/state"
            }
          },
          "required": [
            "type",
            "id",
            "state"
          ],
          "additionalProperties": false
        }
      ]
    },
    "conditions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/condition"
      },
      "minItems": 0
    },
    "references": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/id"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "witness": {
      "oneOf": [
        {
          "$ref": "urn:s1:schema:common#/$defs/id"
        },
        {
          "type": "object",
          "properties": {
            "person": {
              "$ref": "urn:s1:schema:common#/$defs/id"
            },
            "text": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "person",
            "text"
          ],
          "additionalProperties": false
        }
      ],
      "description": "목격자 id 또는 목격자 id와 증언. 증언은 검사기에서 두 문장 이내로 확인한다."
    },
    "placeholder": {
      "type": "string",
      "enum": [
        "person",
        "person2",
        "captain",
        "community",
        "law",
        "place",
        "car",
        "item",
        "n",
        "n2"
      ],
      "description": "이름 있는 자리표시자(s1_content_guide 6.3). 문장엔 {person}처럼 쓴다."
    },
    "textParams": {
      "type": "array",
      "items": {
        "$ref": "urn:s1:schema:common#/$defs/placeholder"
      },
      "uniqueItems": true,
      "description": "이 항목의 글이 쓰는 자리표시자 전부(6.3)."
    },
    "textPlural": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "enum": [
          "n",
          "n2"
        ]
      },
      "description": "글 키(body, c_give.say 등) → 수를 정하는 자리표시자(6.5)."
    },
    "textGender": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "enum": [
          "person",
          "person2",
          "captain"
        ]
      },
      "description": "글 키 → 주어인 사람 자리표시자(6.5)."
    },
    "textNotes": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      },
      "description": "글 키 → 번역자·Gemini용 문맥 한 줄(6.4)."
    }
  }
}
