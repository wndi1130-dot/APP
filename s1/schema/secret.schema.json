{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:s1:schema:secret",
  "title": "비밀",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "urn:s1:schema:common#/$defs/id"
    },
    "kind": {
      "type": "string",
      "enum": [
        "부패",
        "과거",
        "가족",
        "내통",
        "숨긴 상처",
        "거짓"
      ]
    },
    "severity": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "proof": {
      "type": "string",
      "enum": [
        "rumor",
        "evidence"
      ]
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "밀고자",
          "감시",
          "필드 문서",
          "포로"
        ]
      },
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "content_type": {
      "const": "secret"
    },
    "params": {
      "$ref": "urn:s1:schema:common#/$defs/textParams"
    },
    "plural": {
      "$ref": "urn:s1:schema:common#/$defs/textPlural"
    },
    "gender_of": {
      "$ref": "urn:s1:schema:common#/$defs/textGender"
    },
    "notes": {
      "$ref": "urn:s1:schema:common#/$defs/textNotes"
    }
  },
  "required": [
    "id",
    "kind",
    "severity",
    "proof",
    "sources",
    "text"
  ],
  "additionalProperties": false
}
