{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:s1:schema:event",
  "title": "사건 카드",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "urn:s1:schema:common#/$defs/id"
    },
    "stage": {
      "type": "string",
      "enum": [
        "s1a",
        "s1b",
        "s1c"
      ]
    },
    "phase": {
      "type": "string",
      "enum": [
        "travel",
        "stop",
        "council",
        "settle"
      ]
    },
    "trigger": {
      "$ref": "urn:s1:schema:common#/$defs/conditions"
    },
    "speaker": {
      "type": "string",
      "enum": [
        "captain",
        "deputy",
        "ration_officer",
        "rep",
        "aide",
        "faction_leader",
        "tail",
        "engine",
        "guard",
        "medtech",
        "front"
      ]
    },
    "body": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "choices": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^c_[a-z0-9_]+$",
            "description": "선택지 id. 번역 키 <사건 id>.<선택지 id>.<필드>에 쓴다(6.2). 순번 대신 쓴다."
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 15,
            "pattern": "^[^\\r\\n]+$",
            "description": "무엇을 하는지 짧게. 일지에 남는다."
          },
          "say": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40,
            "pattern": "^[^\\r\\n]+$",
            "description": "카드에 보이는 열차장의 말. 한두 문장. 효과와 비용은 넣지 않는다(2026-10-07 사용자)."
          },
          "effects": {
            "$ref": "urn:s1:schema:effects#/$defs/list"
          },
          "followups": {
            "$ref": "urn:s1:schema:common#/$defs/references"
          },
          "witnesses": {
            "type": "array",
            "items": {
              "$ref": "urn:s1:schema:common#/$defs/witness"
            },
            "minItems": 0
          }
        },
        "required": [
          "id",
          "label",
          "effects",
          "followups",
          "witnesses"
        ],
        "additionalProperties": false
      },
      "minItems": 2,
      "maxItems": 4
    },
    "repeat": {
      "type": "integer",
      "minimum": 0
    },
    "chronicle": {
      "$ref": "urn:s1:schema:common#/$defs/id"
    },
    "content_type": {
      "const": "event"
    },
    "params": {
      "$ref": "urn:s1:schema:common#/$defs/textParams"
    },
    "plural": {
      "$ref": "urn:s1:schema:common#/$defs/textPlural"
    },
    "gender_of": {
      "$ref": "urn:s1:schema:common#/$defs/textGender"
    },
    "notes": {
      "$ref": "urn:s1:schema:common#/$defs/textNotes"
    }
  },
  "required": [
    "id",
    "stage",
    "phase",
    "trigger",
    "speaker",
    "body",
    "choices",
    "repeat"
  ],
  "additionalProperties": false
}
